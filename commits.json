        "patch": "@@ -0,0 +1,19 @@\n+name: \"Lint PR\"\n+\n+on:\n+  pull_request_target:\n+    types:\n+      - opened\n+      - edited\n+      - synchronize\n+\n+jobs:\n+  main:\n+    name: Validate PR title\n+    runs-on: ubuntu-slim\n+    permissions:\n+      pull-requests: read\n+    steps:\n+      - uses: amannn/action-semantic-pull-request@v6\n+        env:\n+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}"
