        "patch": "@@ -0,0 +1,33 @@\n+---\n+import { Image } from \"astro:assets\";\n+import check_icon from \"../assets/images/ui/check.webp\";\n+import copy_icon from \"../assets/images/ui/copy.webp\";\n+---\n+\n+<button\n+\tid=\"copy-ip-button\"\n+\tclass=\"flex w-full cursor-pointer items-center justify-center gap-2 bg-yellow-300 py-1\"\n+>\n+\t<Image\n+\t\tid=\"copy-ip-icon\"\n+\t\tsrc={copy_icon}\n+\t\tdata-check-icon={check_icon.src}\n+\t\tclass=\"inline w-5 md:w-4\"\n+\t\talt=\"copy icon\"\n+\t/>\n+\t<p id=\"copy-ip-label\" class=\"font-semibold text-black\">\n+\t\tcs1a.sparked.network\n+\t</p>\n+</button>\n+\n+<script>\n+\tconst button = document.getElementById(\"copy-ip-button\");\n+\tconst icon = document.getElementById(\"copy-ip-icon\") as HTMLImageElement;\n+\tconst text = document.getElementById(\"copy-ip-label\");\n+\n+\tbutton!.addEventListener(\"click\", () => {\n+\t\tnavigator.clipboard.writeText(\"cs1a.sparked.network\");\n+\t\ticon.src = icon.dataset.checkIcon!;\n+\t\ttext!.textContent = \"Server IP Copied!\";\n+\t});\n+</script>"
      },
