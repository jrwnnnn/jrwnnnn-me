        "sha": "6b6780b869c8679116892b789115582edf7334ca",
        "filename": "src/components/PlayerList.astro",
        "status": "added",
        "additions": 83,
        "deletions": 0,
        "changes": 83,
        "blob_url": "https://github.com/jrwnnnn/block1a/blob/99783a3904b54ed9790af1431d65c0aad016c862/src%2Fcomponents%2FPlayerList.astro",
        "raw_url": "https://github.com/jrwnnnn/block1a/raw/99783a3904b54ed9790af1431d65c0aad016c862/src%2Fcomponents%2FPlayerList.astro",
        "contents_url": "https://api.github.com/repos/jrwnnnn/block1a/contents/src%2Fcomponents%2FPlayerList.astro?ref=99783a3904b54ed9790af1431d65c0aad016c862",
        "patch": "@@ -0,0 +1,83 @@\n+---\n+import { env } from \"cloudflare:workers\";\n+\n+interface D1Response<T> {\n+\tsuccess: boolean;\n+\tresults: T[];\n+}\n+\n+interface Player {\n+\tusername: string;\n+\tuuid: string;\n+\tisOnline: number;\n+}\n+\n+interface Skin {\n+\tuuid: string;\n+\turl: string;\n+}\n+\n+async function query<T>(query: string, label: string): Promise<T[]> {\n+\ttry {\n+\t\tconst res: D1Response<T> = await env.DB.prepare(query).all();\n+\n+\t\tif (!res.success) {\n+\t\t\tthrow new Error(`Failed to fetch ${label} from the database.`);\n+\t\t}\n+\n+\t\treturn res.results;\n+\t} catch (e) {\n+\t\tconsole.error(`Error fetching ${label}:`, e);\n+\t\treturn [];\n+\t}\n+}\n+\n+const players = await query<Player>(\n+\t\"SELECT * FROM player_data ORDER BY username COLLATE NOCASE\",\n+\t\"players\",\n+);\n+const skins = await query<Skin>(\"SELECT uuid, url FROM skins\", \"skins\");\n+\n+const skinsMap = new Map<string, string>(skins.map((s) => [s.uuid, s.url]));\n+\n+const merged = players.map((player) => ({\n+\t...player,\n+\tisOnline: Boolean(player.isOnline),\n+\tskin: skinsMap.get(player.uuid) ?? null,\n+}));\n+---\n+\n+<div class=\"flex flex-col gap-2\">\n+\t{\n+\t\tmerged\n+\t\t\t.filter((player) => player.isOnline)\n+\t\t\t.map((player) => (\n+\t\t\t\t<div class=\"flex cursor-pointer gap-2\">\n+\t\t\t\t\t<img\n+\t\t\t\t\t\tsrc={`https://mc-heads.net/avatar/${player.skin?.split(\"/\").pop()}`}\n+\t\t\t\t\t\tclass=\"w-7 object-contain object-center\"\n+\t\t\t\t\t/>\n+\t\t\t\t\t<div>\n+\t\t\t\t\t\t<p class=\"truncate\">{player.username}</p>\n+\t\t\t\t\t\t<p class=\"text-xs text-yellow-300\">Online</p>\n+\t\t\t\t\t</div>\n+\t\t\t\t</div>\n+\t\t\t))\n+\t}\n+\t{\n+\t\tmerged\n+\t\t\t.filter((player) => !player.isOnline)\n+\t\t\t.map((player) => (\n+\t\t\t\t<div class=\"flex cursor-pointer gap-2\">\n+\t\t\t\t\t<img\n+\t\t\t\t\t\tsrc={`https://mc-heads.net/avatar/${player.skin?.split(\"/\").pop()}`}\n+\t\t\t\t\t\tclass=\"w-7 object-contain object-center grayscale\"\n+\t\t\t\t\t/>\n+\t\t\t\t\t<div>\n+\t\t\t\t\t\t<p class=\"truncate\">{player.username}</p>\n+\t\t\t\t\t\t<p class=\"text-xs text-[#a6c0b8]\">Offline</p>\n+\t\t\t\t\t</div>\n+\t\t\t\t</div>\n+\t\t\t))\n+\t}\n+</div>"
      },
