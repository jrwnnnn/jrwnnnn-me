        "patch": "@@ -0,0 +1,59 @@\n+---\n+import { Image } from \"astro:assets\";\n+const lastfm = await (\n+  await fetch(\n+    `https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=KeiCantRead&api_key=${import.meta.env.LASTFM_API_KEY}&format=json&limit=5`,\n+  )\n+).json();\n+---\n+\n+<!-- TODO: Implement realtime ajax-->\n+<div\n+  class=`bg-green-500 py-px px-2 font-mono text-[12px] font-bold text-black ${lastfm.recenttracks.track[0]['@attr']?.nowplaying === 'true' ? '' : 'hidden'}`\n+>\n+  NOW SCROBBLING\n+</div>\n+<a class=\"flex cursor-pointer gap-5\" href={lastfm.recenttracks.track[0].url}>\n+  <div class=\"group relative w-30 border border-green-500\">\n+    <Image\n+      src={lastfm.recenttracks.track[0].image[3][\"#text\"]}\n+      alt={lastfm.recenttracks.track[0].album[\"#text\"]}\n+      width=\"300\"\n+      height=\"300\"\n+      class=\"h-full w-full object-cover brightness-90 contrast-125 grayscale transition group-hover:brightness-100 group-hover:contrast-100 group-hover:grayscale-0\"\n+    />\n+\n+    <div\n+      class=\"pointer-events-none absolute inset-0 bg-green-500/90 mix-blend-multiply group-hover:hidden\"\n+    >\n+    </div>\n+  </div>\n+  <div>\n+    <p class=\"mb-2 text-xl font-bold tracking-normal\">\n+      {lastfm.recenttracks.track[0].name}\n+    </p>\n+    <p class=\"font-mono text-xs text-green-700\">\n+      Artist: {lastfm.recenttracks.track[0].artist[\"#text\"]}\n+    </p>\n+    <p class=\"font-mono text-xs text-green-700\">\n+      Album: {lastfm.recenttracks.track[0].album[\"#text\"]}\n+    </p>\n+  </div>\n+</a>\n+<div>\n+  <div class=\"flex items-center gap-2\">\n+    <hr class=\"grow border border-dashed border-green-900\" />\n+    <p class=\"text-center font-mono text-xs tracking-widest text-green-900\">\n+      Recent Tracks\n+    </p>\n+    <hr class=\"grow border border-dashed border-green-900\" />\n+  </div>\n+  {\n+    lastfm.recenttracks.track.slice(1).map((track: any) => (\n+      <div class=\"flex items-center justify-between\">\n+        <p class=\"text-green-600\">{track.name}</p>\n+        <p class=\"font-mono text-xs text-green-700\">{track.artist[\"#text\"]}</p>\n+      </div>\n+    ))\n+  }\n+</div>"
