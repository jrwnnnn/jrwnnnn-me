        "patch": "@@ -0,0 +1,61 @@\n+<form method=\"POST\" class=\"space-y-5\">\n+\t<div>\n+\t\t<label for=\"name\" class=\"form-label\">Name</label>\n+\t\t<input\n+\t\t\ttype=\"text\"\n+\t\t\tid=\"name\"\n+\t\t\tname=\"name\"\n+\t\t\trequired\n+\t\t\tautocomplete=\"off\"\n+\t\t\tplaceholder=\"Their name\"\n+\t\t\tclass=\"form-input\"\n+\t\t/>\n+\t</div>\n+\n+\t<div class=\"grid grid-cols-2 gap-3\">\n+\t\t<div>\n+\t\t\t<label for=\"birth_year\" class=\"form-label\">Born</label>\n+\t\t\t<input\n+\t\t\t\ttype=\"number\"\n+\t\t\t\tid=\"birth_year\"\n+\t\t\t\tname=\"birth_year\"\n+\t\t\t\trequired\n+\t\t\t\tautocomplete=\"off\"\n+\t\t\t\tplaceholder=\"2013\"\n+\t\t\t\tclass=\"form-input\"\n+\t\t\t/>\n+\t\t</div>\n+\t\t<div>\n+\t\t\t<label for=\"death_year\" class=\"form-label\">Passed</label>\n+\t\t\t<input\n+\t\t\t\ttype=\"number\"\n+\t\t\t\tid=\"death_year\"\n+\t\t\t\tname=\"death_year\"\n+\t\t\t\trequired\n+\t\t\t\tautocomplete=\"off\"\n+\t\t\t\tplaceholder=\"2026\"\n+\t\t\t\tclass=\"form-input\"\n+\t\t\t/>\n+\t\t</div>\n+\t</div>\n+\n+\t<div class=\"pt-1\">\n+\t\t<button\n+\t\t\ttype=\"submit\"\n+\t\t\tclass=\"w-full cursor-pointer rounded-xl border border-white/10 bg-white/6 px-5 py-3 text-sm font-medium text-white/75 transition-all duration-200 hover:border-white/20 hover:bg-white/10 hover:text-white hover:shadow-[0_0_24px_rgba(255,255,255,0.05)]\"\n+\t\t>\n+\t\t\tSubmit\n+\t\t</button>\n+\t</div>\n+</form>\n+\n+<style is:global>\n+\t@reference \"../styles/global.css\";\n+\n+\t.form-label {\n+\t\t@apply mb-1.5 block text-xs font-medium tracking-widest text-white/40 uppercase;\n+\t}\n+\t.form-input {\n+\t\t@apply w-full rounded-xl border border-white/8 bg-white/4 px-4 py-2.5 text-sm text-white transition-shadow duration-200 outline-none placeholder:text-white/20 focus:border-indigo-200/25 [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none;\n+\t}\n+</style>"
