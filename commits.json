        "patch": "@@ -1,7 +1,4 @@\n ---\n-import { safeAsync } from \"@utils/safeAsync\";\n-import ErrorOut from \"./ErrorOut.astro\";\n-\n interface ContributionDay {\n \tcontributionCount: number;\n \tdate: string;\n@@ -24,38 +21,38 @@ interface GraphQL {\n \t};\n }\n \n-const response = await safeAsync(\n-\tfetch(\"https://api.github.com/graphql\", {\n-\t\tmethod: \"POST\",\n-\t\theaders: {\n-\t\t\tAuthorization: `Bearer ${import.meta.env.GITHUB_TOKEN}`,\n-\t\t\t\"User-Agent\": \"jrwnnnn-me-heatmap\",\n-\t\t\t\"Content-Type\": \"application/json\",\n-\t\t},\n-\t\tbody: JSON.stringify({\n-\t\t\tquery: `\n-\t  query($userName:String!) {\n-\t\tuser(login: $userName) {\n-\t\t  contributionsCollection {\n-\t\t\tcontributionCalendar {\n-\t\t\t  totalContributions\n-\t\t\t  weeks {\n-\t\t\t\tcontributionDays {\n-\t\t\t\t  contributionCount\n-\t\t\t\t  date\n+const response = await fetch(\"https://api.github.com/graphql\", {\n+\tmethod: \"POST\",\n+\theaders: {\n+\t\tAuthorization: `Bearer ${import.meta.env.GITHUB_TOKEN}`,\n+\t\t\"User-Agent\": \"jrwnnnn-me-heatmap\",\n+\t\t\"Content-Type\": \"application/json\",\n+\t},\n+\tbody: JSON.stringify({\n+\t\tquery: `\n+\t\t  query($userName:String!) {\n+\t\t\tuser(login: $userName) {\n+\t\t\t  contributionsCollection {\n+\t\t\t\tcontributionCalendar {\n+\t\t\t\t  totalContributions\n+\t\t\t\t  weeks {\n+\t\t\t\t\tcontributionDays {\n+\t\t\t\t\t  contributionCount\n+\t\t\t\t\t  date\n+\t\t\t\t\t}\n+\t\t\t\t  }\n \t\t\t\t}\n \t\t\t  }\n \t\t\t}\n \t\t  }\n-\t\t}\n-\t  }\n-\t`,\n-\t\t\tvariables: { userName: \"jrwnnnn\" },\n-\t\t}),\n+\t\t`,\n+\t\tvariables: { userName: \"jrwnnnn\" },\n \t}),\n-);\n-const graphql = (await response.data!.json()) as GraphQL;\n+});\n+\n+if (!response.ok) return;\n \n+const graphql = (await response.json()) as GraphQL;\n const contributions =\n \tgraphql.data.user.contributionsCollection.contributionCalendar.weeks.flatMap(\n \t\t(w: Week) => w.contributionDays,\n@@ -75,7 +72,7 @@ function getColor(count: number) {\n ---\n \n {\n-\tresponse.data ? (\n+\t(\n \t\t<div id=\"heatmap\" class=\"w-full cursor-pointer overflow-x-auto pb-2\">\n \t\t\t<div class=\"flex gap-1\">\n \t\t\t\t{graphql.data.user.contributionsCollection?.contributionCalendar.weeks.map(\n@@ -92,8 +89,8 @@ function getColor(count: number) {\n \t\t\t\t)}\n \t\t\t</div>\n \t\t</div>\n-\t) : (\n-\t\t<ErrorOut error={response.error as Error} />\n+\n+\t\t// TODO: Add error a proper error handling in case the API request fails\n \t)\n }\n "
