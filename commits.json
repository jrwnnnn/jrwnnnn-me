        "patch": "@@ -1,11 +1,12 @@\n ---\n import { Image } from \"astro:assets\";\n import logo from \"../assets/images/ui/logo.webp\";\n+import ServerStatus from \"./ServerStatus.astro\";\n ---\n \n <nav class=\"flex items-center justify-between bg-[#0a1517] px-5 py-4 md:px-30\">\n \t<a href=\"/\">\n \t\t<Image src={logo} class=\"w-20 hover:cursor-pointer\" alt=\"Logo\" />\n \t</a>\n-\t<p class=\"cursor-pointer hover:text-yellow-300\">Login</p>\n+\t<ServerStatus />\n </nav>"
      },
      {
        "sha": "1c8e318edbf00c48a687a91342c5daedc61aba58",
        "filename": "src/components/ServerStatus.astro",
        "status": "added",
        "additions": 59,
        "deletions": 0,
        "changes": 59,
        "blob_url": "https://github.com/jrwnnnn/block1a/blob/7983fa362df942b0432af89ed2949e3bebf8309d/src%2Fcomponents%2FServerStatus.astro",
        "raw_url": "https://github.com/jrwnnnn/block1a/raw/7983fa362df942b0432af89ed2949e3bebf8309d/src%2Fcomponents%2FServerStatus.astro",
        "contents_url": "https://api.github.com/repos/jrwnnnn/block1a/contents/src%2Fcomponents%2FServerStatus.astro?ref=7983fa362df942b0432af89ed2949e3bebf8309d",
        "patch": "@@ -0,0 +1,59 @@\n+---\n+import { Image } from \"astro:assets\";\n+import server_offline_icon from \"../assets/images/ui/server_offline.webp\";\n+import user_icon from \"../assets/images/ui/user.webp\";\n+\n+interface Status {\n+\thostname: string;\n+\tonline: boolean;\n+\tplayers?: {\n+\t\tonline: number;\n+\t\tmax: number;\n+\t};\n+\tversion: string;\n+}\n+\n+let status: Status | null = null;\n+try {\n+\tconst response = await fetch(\n+\t\t\"https://api.mcsrvstat.us/2/cs1a.sparked.network\",\n+\t\t{\n+\t\t\theaders: {\n+\t\t\t\t\"User-Agent\": \"jrwnnnn/block1a (ping@jrwnnnn.me)\",\n+\t\t\t},\n+\t\t},\n+\t);\n+\n+\tif (!response.ok) {\n+\t\tthrow new Error(\"Failed to fetch server status\");\n+\t}\n+\n+\tstatus = await response.json();\n+} catch (error) {\n+\tconsole.error(\"Error fetching server status:\", error);\n+}\n+---\n+\n+<div class=\"flex items-center gap-2\">\n+\t{\n+\t\tstatus ? (\n+\t\t\tstatus.online && status.players ? (\n+\t\t\t\t<>\n+\t\t\t\t\t<Image src={user_icon} alt=\"User Icon\" class=\"w-5 invert\" />\n+\t\t\t\t\t<p>\n+\t\t\t\t\t\t{status.players.online}/{status.players.max}\n+\t\t\t\t\t</p>\n+\t\t\t\t</>\n+\t\t\t) : (\n+\t\t\t\t<div class=\"flex items-center gap-2 opacity-50\">\n+\t\t\t\t\t<Image\n+\t\t\t\t\t\tsrc={server_offline_icon}\n+\t\t\t\t\t\talt=\"Server Offline\"\n+\t\t\t\t\t\tclass=\"w-5 invert\"\n+\t\t\t\t\t/>\n+\t\t\t\t\t<p>Offline</p>\n+\t\t\t\t</div>\n+\t\t\t)\n+\t\t) : null\n+\t}\n+</div>"
      }
    ]
