        "patch": "@@ -0,0 +1,35 @@\n+-- Migration number: 0001 \t 2026-09-14T10:23:08.307Z\n+PRAGMA defer_foreign_keys=TRUE;\n+CREATE TABLE IF NOT EXISTS \"skins\"(\n+  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT UNIQUE NOT NULL,\n+  \"uuid\" TEXT UNIQUE NOT NULL, \"url\" TEXT);\n+CREATE TABLE IF NOT EXISTS \"player_data\"(\n+  \"id\" INTEGER PRIMARY KEY UNIQUE NOT NULL,\n+  \"uuid\" TEXT UNIQUE NOT NULL,\n+  \"username\" TEXT NOT NULL,\n+  \"isOnline\" INTEGER NOT NULL,\n+  \"firstSeen\" TEXT NOT NULL,\n+  \"lastSeen\" TEXT NOT NULL\n+, \"isPrivate\" INTEGER NOT NULL DEFAULT '1');\n+CREATE TABLE IF NOT EXISTS \"loadouts\"(\n+  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL\n+);\n+CREATE TABLE IF NOT EXISTS \"statistics\"(\n+  \"id\" INTEGER PRIMARY KEY AUTOINCREMENT UNIQUE NOT NULL,\n+  \"uuid\" TEXT UNIQUE NOT NULL,\n+  \"advancements\" INTEGER NOT NULL DEFAULT '0',\n+  \"blocksMined\" INTEGER NOT NULL DEFAULT '0',\n+  \"blocksPlaced\" INTEGER NOT NULL DEFAULT '0',\n+  \"damageAbsorbed\" INTEGER NOT NULL DEFAULT '0',\n+  \"damageDealt\" INTEGER NOT NULL DEFAULT '0',\n+  \"damageTaken\" INTEGER NOT NULL DEFAULT '0',\n+  \"damageResisted\" INTEGER NOT NULL DEFAULT '0',\n+  \"distanceTraveled\" INTEGER NOT NULL DEFAULT '0',\n+  \"deaths\" INTEGER NOT NULL DEFAULT '0',\n+  \"level\" INTEGER NOT NULL DEFAULT '0',\n+  \"mobsKilled\" INTEGER NOT NULL DEFAULT '0',\n+  \"playersKilled\" INTEGER NOT NULL DEFAULT '0',\n+  \"playTime\" INTEGER NOT NULL DEFAULT '0',\n+  \"timeSinceLastDeath\" INTEGER NOT NULL DEFAULT '0'\n+);\n+DELETE FROM sqlite_sequence;"
      },
