        "patch": "@@ -0,0 +1,143 @@\n+---\n+import \"../../styles/marked.css\";\n+// import { createClient } from \"@libsql/client\";\n+// import { createSlug } from \"@utils/createSlug\";\n+\n+import Layout from \"../../layouts/Layout.astro\";\n+\n+// ILL BE IMPLEMENTING THIS SOON, JUST WANT A PLACEHOLDER FOR NOW\n+// const turso = createClient({\n+// \turl: process.env.TURSO_DATABASE_URL || import.meta.env.TURSO_DATABASE_URL,\n+\n+// \tauthToken: process.env.TURSO_AUTH_TOKEN || import.meta.env.TURSO_AUTH_TOKEN,\n+// });\n+\n+// let message = \"\";\n+\n+// if (Astro.request.method === \"POST\") {\n+// \ttry {\n+// \t\tconst data = await Astro.request.formData();\n+// \t\tconst title = data.get(\"title\")?.toString() ?? \"\";\n+// \t\tconst subtitle = data.get(\"subtitle\")?.toString() ?? null;\n+// \t\tconst content = data.get(\"content\")?.toString() ?? \"\";\n+// \t\t// TODO: Prevent duplicate slugs by appending a number if the slug already exists\n+// \t\tconst slug = createSlug(title);\n+\n+// \t\tif (title) {\n+// \t\t\tawait turso.execute(\n+// \t\t\t\t\"INSERT INTO articles (title, subtitle, content, date_created, slug) VALUES (?, ?, ?, ?, ?)\",\n+// \t\t\t\t[title, subtitle, content, new Date().toISOString(), slug],\n+// \t\t\t);\n+// \t\t\tmessage = \"Record inserted successfully.\";\n+// \t\t\treturn new Response(null, {\n+// \t\t\t\tstatus: 301,\n+// \t\t\t\theaders: { Location: `/transmission/${slug}` }\n+// \t\t\t});\n+// \t\t}\n+// \t} catch (error) {\n+// \t\tmessage = `Insertion failed: ${error instanceof Error ? error.message : \"Unknown error\"}`;\n+// \t}\n+// }\n+---\n+\n+<Layout title=\"Mark Jerwin // TRANSMIT\" robots=\"noindex, nofollow\">\n+\t<main class=\"flex flex-col items-center justify-center\">\n+\t\t<svg\n+\t\t\tid=\"preview-toggle\"\n+\t\t\txmlns=\"http://www.w3.org/2000/svg\"\n+\t\t\tviewBox=\"0 0 24 24\"\n+\t\t\tfill=\"#000\"\n+\t\t\tstroke=\"#00c951\"\n+\t\t\twidth=\"30\"\n+\t\t\theight=\"30\"\n+\t\t\tclass=\"mb-10 cursor-pointer\"\n+\t\t>\n+\t\t\t<path\n+\t\t\t\td=\"M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z\"\n+\t\t\t></path>\n+\t\t</svg>\n+\n+\t\t<div class=\"w-full font-mono md:w-[60vw]\">\n+\t\t\t<statusbar\n+\t\t\t\tclass=\"flex items-center justify-between border border-b-0 border-green-800 bg-green-900/20 px-4 py-2 text-xs tracking-widest uppercase\"\n+\t\t\t>\n+\t\t\t\t<span>PREVIEW</span>\n+\n+\t\t\t\t<time datetime={new Date().toISOString()}>\n+\t\t\t\t\t{\n+\t\t\t\t\t\tnew Date().toLocaleDateString(\"en-US\", {\n+\t\t\t\t\t\t\tyear: \"numeric\",\n+\t\t\t\t\t\t\tmonth: \"short\",\n+\t\t\t\t\t\t\tday: \"numeric\",\n+\t\t\t\t\t\t})\n+\t\t\t\t\t}\n+\t\t\t\t</time>\n+\t\t\t</statusbar>\n+\n+\t\t\t<form\n+\t\t\t\tmethod=\"POST\"\n+\t\t\t\tclass=\"flex flex-col space-y-5 border border-green-800 bg-black p-6 md:p-12\"\n+\t\t\t>\n+\t\t\t\t<textarea\n+\t\t\t\t\tclass=\"w-full rounded-none text-4xl leading-none font-bold uppercase outline-none md:text-5xl\"\n+\t\t\t\t\tname=\"title\"\n+\t\t\t\t\tplaceholder=\"Title\"\n+\t\t\t\t\trows=\"1\"\n+\t\t\t\t\toninput=\"this.style.height = ''; this.style.height = this.scrollHeight + 'px'\"\n+\t\t\t\t\trequired></textarea>\n+\n+\t\t\t\t<textarea\n+\t\t\t\t\tclass=\"w-full text-lg text-green-600 outline-none\"\n+\t\t\t\t\tname=\"subtitle\"\n+\t\t\t\t\tplaceholder=\"Subtitle\"\n+\t\t\t\t\trows=\"2\"\n+\t\t\t\t\toninput=\"this.style.height = ''; this.style.height = this.scrollHeight + 'px'\"\n+\t\t\t\t></textarea>\n+\n+\t\t\t\t<hr class=\"border border-green-900/50\" />\n+\n+\t\t\t\t<textarea\n+\t\t\t\t\tid=\"content-input\"\n+\t\t\t\t\tclass=\"h-full min-h-30 w-full resize-none overflow-hidden outline-none\"\n+\t\t\t\t\tname=\"content\"\n+\t\t\t\t\tplaceholder=\"Start typing here...\"\n+\t\t\t\t\toninput=\"this.style.height = ''; this.style.height = this.scrollHeight + 'px'\"\n+\t\t\t\t\trequired></textarea>\n+\n+\t\t\t\t<div id=\"preview\" class=\"prose hidden min-h-30\"></div>\n+\n+\t\t\t\t<hr class=\"border border-green-900/50\" />\n+\n+\t\t\t\t<p class=\"text-center text-sm text-green-800 italic\">\n+\t\t\t\t\tEND OF TRANSMISSION\n+\t\t\t\t</p>\n+\n+\t\t\t\t<!-- <button\n+\t\t\t\t\ttype=\"submit\"\n+\t\t\t\t\tclass=\"cursor-pointer self-end px-3 py-2 text-sm font-bold tracking-widest hover:bg-green-500 hover:text-black hover:brightness-110\"\n+\t\t\t\t>\n+\t\t\t\t\t[ TRANSMIT ]\n+\t\t\t\t</button> -->\n+\t\t\t</form>\n+\t\t</div>\n+\t</main>\n+</Layout>\n+\n+<script>\n+\timport { marked } from \"marked\";\n+\tconst toggle = document.getElementById(\"preview-toggle\");\n+\tconst input = document.getElementById(\"content-input\") as HTMLTextAreaElement;\n+\tconst preview = document.getElementById(\"preview\");\n+\n+\tif (toggle && input && preview) {\n+\t\ttoggle.addEventListener(\"click\", async () => {\n+\t\t\tconst isEditing = !input.classList.contains(\"hidden\");\n+\n+\t\t\tif (isEditing) preview.innerHTML = await marked.parse(input.value);\n+\t\t\tinput.classList.toggle(\"hidden\", isEditing);\n+\t\t\tpreview.classList.toggle(\"hidden\", !isEditing);\n+\t\t\ttoggle.setAttribute(\"fill\", isEditing ? \"#00c951\" : \"#000\");\n+\t\t\ttoggle.setAttribute(\"stroke\", isEditing ? \"#000\" : \"#00c951\");\n+\t\t});\n+\t}\n+</script>"
      }
