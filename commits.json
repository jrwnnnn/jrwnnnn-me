        "patch": "@@ -2,6 +2,7 @@\n import { Image } from \"astro:assets\";\n import Layout from \"../layouts/Layout.astro\";\n import Navigation from \"../components/Navigation.astro\";\n+import PlayerList from \"../components/PlayerList.astro\";\n \n import splash from \"../assets/images/backgrounds/lush_cave.webp\";\n import map from \"../assets/images/ui/map.webp\";\n@@ -25,7 +26,7 @@ import warning from \"../assets/images/ui/warning.webp\";\n \t\tclass=\"h-[50vh] object-cover object-center\"\n \t/>\n \n-\t<main class=\"mt-5 grid grid-cols-2\">\n+\t<main class=\"my-5 grid gap-8 md:grid-cols-[2fr_1fr]\">\n \t\t<section class=\"flex flex-col gap-5\">\n \t\t\t<div>\n \t\t\t\t<p class=\"mb-3 text-lg font-bold\">About the server</p>\n@@ -54,5 +55,11 @@ import warning from \"../assets/images/ui/warning.webp\";\n \t\t\t\t</div>\n \t\t\t</a>\n \t\t</section>\n+\t\t<section>\n+\t\t\t<div class=\"mb-3 flex items-baseline justify-between\">\n+\t\t\t\t<p class=\"text-lg font-bold\">Players</p>\n+\t\t\t</div>\n+\t\t\t<PlayerList />\n+\t\t</section>\n \t</main>\n </Layout>"
