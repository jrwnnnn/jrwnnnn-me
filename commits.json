        "patch": "@@ -1,75 +1,88 @@\n ---\n-const lastfm = await (\n-\tawait fetch(\n-\t\t`https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=KeiCantRead&api_key=${process.env.LASTFM_API_KEY || import.meta.env.LASTFM_API_KEY}&format=json&limit=5`,\n-\t\t{\n-\t\t\theaders: { \"User-Agent\": \"Mozilla/5.0\" },\n-\t\t},\n-\t)\n-).json();\n+\n ---\n \n-<!-- TODO: Implement realtime ajax-->\n-<div class=\"flex items-center justify-between\">\n-\t<p class=\"text-lg font-bold tracking-widest\">> LAST_FM</p>\n-\t<div\n-\t\tclass=`bg-green-500 px-3 py-px font-mono text-[12px] text-black ${lastfm.recenttracks.track[0]['@attr']?.nowplaying === 'true' ? '' : 'hidden'}`\n-\t>\n-\t\tLIVE\n-\t</div>\n+<div id=\"lastfm-widget\" class=\"animate-pulse space-y-5\">\n+\t<p class=\"text-lg font-bold tracking-widest\">> CONNECTING_TO_LAST_FM</p>\n </div>\n-<hr class=\"border border-green-500/30\" />\n-<a\n-\tclass=\"flex cursor-pointer flex-col gap-5 md:flex-row\"\n-\thref={lastfm.recenttracks.track[0].url}\n-\ttarget=\"_blank\"\n->\n-\t<div class=\"group relative w-full border border-green-500 md:w-30\">\n-\t\t<img\n-\t\t\tsrc={lastfm.recenttracks.track[0].image[3][\"#text\"]}\n-\t\t\talt={lastfm.recenttracks.track[0].album[\"#text\"]}\n-\t\t\tclass=\"h-full w-full object-cover contrast-125 grayscale transition group-hover:contrast-100 group-hover:grayscale-0\"\n-\t\t/>\n \n-\t\t<div\n-\t\t\tclass=\"pointer-events-none absolute inset-0 bg-green-500/90 mix-blend-multiply group-hover:hidden\"\n-\t\t>\n-\t\t</div>\n-\t</div>\n-\t<div>\n-\t\t<p class=\"text-lg font-bold\">\n-\t\t\t{lastfm.recenttracks.track[0].name}\n-\t\t</p>\n-\t\t<p class=\"font-mono text-sm text-green-600\">\n-\t\t\tArtist: {lastfm.recenttracks.track[0].artist[\"#text\"]}\n-\t\t</p>\n-\t\t<p class=\"font-mono text-sm text-green-600\">\n-\t\t\tAlbum: {lastfm.recenttracks.track[0].album[\"#text\"]}\n-\t\t</p>\n-\t</div>\n-</a>\n-<div>\n-\t<div class=\"mb-2 flex items-center gap-2\">\n-\t\t<hr class=\"grow border border-dashed border-green-900\" />\n-\t\t<p class=\"text-center font-mono text-xs tracking-widest text-green-900\">\n-\t\t\tRecent Tracks\n-\t\t</p>\n-\t\t<hr class=\"grow border border-dashed border-green-900\" />\n-\t</div>\n-\t<div>\n-\t\t<!--TODO: Fix responsiveness -->\n-\t\t{\n-\t\t\tlastfm.recenttracks.track.slice(1).map((track: any) => (\n-\t\t\t\t<a\n-\t\t\t\t\thref={track.url}\n-\t\t\t\t\tclass=\"mb-1 flex gap-5 font-mono text-sm md:mb-0 md:flex md:justify-between\"\n-\t\t\t\t>\n-\t\t\t\t\t<p class=\"line-clamp-1 text-green-600\">{track.name}</p>\n-\t\t\t\t\t<p class=\"line-clamp-1 text-left text-green-800\">\n-\t\t\t\t\t\t{track.artist[\"#text\"]}\n-\t\t\t\t\t</p>\n-\t\t\t\t</a>\n-\t\t\t))\n+<script>\n+\tinterface Interface {\n+\t\tname: string;\n+\t\tartist: { \"#text\": string };\n+\t\talbum: { \"#text\": string };\n+\t\timage: { \"#text\": string }[];\n+\t\turl: string;\n+\t\t\"@attr\"?: { nowplaying: string };\n+\t}\n+\n+\tconst widget = document.getElementById(\"lastfm-widget\");\n+\n+\tconst render = (tracks: Interface[]) => {\n+\t\tconst nowPlaying = tracks[0][\"@attr\"]?.nowplaying === \"true\";\n+\t\tconst recent = nowPlaying ? tracks.slice(1) : tracks;\n+\n+\t\treturn `\n+            <div class=\"flex items-center justify-between\">\n+                <p class=\"text-lg font-bold tracking-widest\">> LAST_FM</p>\n+                <div class=\"${nowPlaying ? \"bg-green-500\" : \"hidden\"} px-3 py-px font-mono text-[12px] text-black animate-pulse\">\n+                    LIVE\n+                </div>\n+            </div>\n+            <hr class=\"border border-green-500/30\" />\n+            \n+            <a class=\"flex cursor-pointer flex-col gap-5 md:flex-row\" ${nowPlaying ? `href=${tracks[0].url}` : \"\"} target=\"_blank\">\n+\t\t\t\t<div class=\"group relative w-full border border-green-500 md:w-30\">\n+\t\t\t\t\t<img\n+\t\t\t\t\t\tsrc=\"${nowPlaying ? tracks[0].image[3][\"#text\"] : \"https://www.last.fm/static/images/lastfm_avatar_twitter.52a5d69a85ac.png\"}\" \n+\t\t\t\t\t\talt=\"${nowPlaying ? tracks[0].album[\"#text\"] : \"LastFM\"}\" \n+\t\t\t\t\t\tclass=\"h-full w-full object-cover contrast-125 grayscale transition group-hover:contrast-100 group-hover:grayscale-0\"\n+\t\t\t\t\t/>\n+\t\t\t\t\t<div\n+\t\t\t\t\t\tclass=\"pointer-events-none absolute inset-0 bg-green-500/90 mix-blend-multiply group-hover:hidden\"\n+\t\t\t\t\t>\n+\t\t\t\t\t</div>\n+\t\t\t\t</div>\n+                <div>\n+                    <p class=\"text-lg font-bold tracking-wide\">${nowPlaying ? tracks[0].name : \"Nothing is currently being played...\"}</p>\n+                    <p class=\"font-mono text-sm text-green-600\">${nowPlaying ? `Artist: ${tracks[0].artist[\"#text\"]}` : \"Offline\"}</p>\n+                    <p class=\"font-mono text-sm text-green-600 ${!nowPlaying ? \"hidden\" : \"\"}\">Album: ${tracks[0].album[\"#text\"]}</p>\n+                </div>\n+            </a>\n+\n+            <div class=\"flex items-center gap-2\">\n+                <hr class=\"grow border border-dashed border-green-900\" />\n+                <p class=\"text-center font-mono text-xs tracking-widest text-green-900\">Recent Tracks</p>\n+                <hr class=\"grow border border-dashed border-green-900\" />\n+            </div>\n+            \n+            <div class=\"flex flex-col gap-1\">\n+                ${recent\n+\t\t\t\t\t\t\t\t\t.map(\n+\t\t\t\t\t\t\t\t\t\t(track) => `\n+                    <a href=\"${track.url}\" target=\"_blank\" class=\"flex gap-5 font-mono text-sm md:flex md:justify-between hover:text-green-400 transition-colors\">\n+                        <p class=\"line-clamp-1 text-green-600\">${track.name}</p>\n+                        <p class=\"line-clamp-1 text-left text-green-800 whitespace-nowrap\">${track.artist[\"#text\"]}</p>\n+                    </a>\n+                `,\n+\t\t\t\t\t\t\t\t\t)\n+\t\t\t\t\t\t\t\t\t.join(\"\")}\n+            </div>\n+        `;\n+\t};\n+\n+\tconst fetchAndRender = async () => {\n+\t\ttry {\n+\t\t\tconst data = await (await fetch(\"/api/lastfm-endpoint\")).json();\n+\t\t\tconst tracks = data.recenttracks.track as Interface[];\n+\n+\t\t\twidget!.innerHTML = render(tracks);\n+\t\t\twidget!.classList.remove(\"animate-pulse\");\n+\t\t} catch (e) {\n+\t\t\tconsole.error(e);\n \t\t}\n-\t</div>\n-</div>\n+\t};\n+\n+\tfetchAndRender();\n+\tsetInterval(fetchAndRender, 10000);\n+</script>"
