      {
        "sha": "2b9634c649c9535b10b7ef28ba49cd752e100d89",
        "filename": "src/stores/connectivity.ts",
        "status": "added",
        "additions": 108,
        "deletions": 0,
        "changes": 108,
        "blob_url": "https://github.com/jrwnnnn/zipo/blob/bd3146dc8d2d5599095a84e03f695fafd3fc9a19/src%2Fstores%2Fconnectivity.ts",
        "raw_url": "https://github.com/jrwnnnn/zipo/raw/bd3146dc8d2d5599095a84e03f695fafd3fc9a19/src%2Fstores%2Fconnectivity.ts",
        "contents_url": "https://api.github.com/repos/jrwnnnn/zipo/contents/src%2Fstores%2Fconnectivity.ts?ref=bd3146dc8d2d5599095a84e03f695fafd3fc9a19",
        "patch": "@@ -0,0 +1,108 @@\n+import { Toast } from \"@capacitor/toast\";\n+import {\n+\tBleClient,\n+\ttype BleDevice,\n+\tdataViewToText,\n+} from \"@capacitor-community/bluetooth-le\";\n+import { defineStore } from \"pinia\";\n+import { ref } from \"vue\";\n+\n+const SERVICE_UUID = \"6e400001-b5a3-f393-e0a9-e50e24dcca9e\";\n+// const RX_UUID = \"6e400002-b5a3-f393-e0a9-e50e24dcca9e\";\n+const TX_UUID = \"6e400003-b5a3-f393-e0a9-e50e24dcca9e\";\n+\n+export const useConnectivityStore = defineStore(\"zipo\", () => {\n+\tconst state = ref<\"connected\" | \"connecting\" | \"idle\">(\"idle\");\n+\tconst esp = ref<BleDevice | null>(null);\n+\n+\tasync function connect() {\n+\t\tif (state.value !== \"idle\") return;\n+\t\tlet found = false;\n+\t\tstate.value = \"connecting\";\n+\n+\t\ttry {\n+\t\t\tawait BleClient.initialize();\n+\t\t\tawait BleClient.requestLEScan(\n+\t\t\t\t{ services: [SERVICE_UUID] },\n+\t\t\t\tasync (result) => {\n+\t\t\t\t\tif (found) return;\n+\t\t\t\t\tfound = true;\n+\n+\t\t\t\t\ttry {\n+\t\t\t\t\t\tawait BleClient.stopLEScan();\n+\n+\t\t\t\t\t\t// connect and listen to the found Zipo\n+\t\t\t\t\t\tawait BleClient.connect(result.device.deviceId, onDisconnect);\n+\t\t\t\t\t\tawait listen(result.device.deviceId);\n+\n+\t\t\t\t\t\tesp.value = {\n+\t\t\t\t\t\t\tdeviceId: result.device.deviceId,\n+\t\t\t\t\t\t\tname: result.device.name,\n+\t\t\t\t\t\t};\n+\t\t\t\t\t\tstate.value = \"connected\";\n+\n+\t\t\t\t\t\tconsole.log(\"Connected to\", esp.value?.deviceId);\n+\t\t\t\t\t} catch (error) {\n+\t\t\t\t\t\tstate.value = \"idle\";\n+\t\t\t\t\t\tconsole.error(\"Connection failed:\", error);\n+\t\t\t\t\t\tawait Toast.show({\n+\t\t\t\t\t\t\ttext: `Can't connect to ${esp.value?.deviceId}`,\n+\t\t\t\t\t\t\tduration: \"long\",\n+\t\t\t\t\t\t});\n+\t\t\t\t\t}\n+\t\t\t\t},\n+\t\t\t);\n+\n+\t\t\tsetTimeout(async () => {\n+\t\t\t\tif (found) return;\n+\t\t\t\tBleClient.stopLEScan();\n+\t\t\t\tstate.value = \"idle\";\n+\t\t\t\tconsole.log(\"No compatible Zipo device found.\");\n+\t\t\t\tawait Toast.show({\n+\t\t\t\t\ttext: \"No compatible Zipo device found.\",\n+\t\t\t\t\tduration: \"long\",\n+\t\t\t\t});\n+\t\t\t}, 8000);\n+\t\t} catch (error) {\n+\t\t\tstate.value = \"idle\";\n+\t\t\tconsole.error(\"Connection failed:\", error);\n+\t\t}\n+\t}\n+\n+\tasync function disconnect() {\n+\t\tif (!esp.value) return;\n+\t\tconst id = esp.value.deviceId;\n+\t\tawait BleClient.disconnect(id);\n+\t\tonDisconnect(id);\n+\t}\n+\n+\tasync function listen(id: string) {\n+\t\tawait BleClient.startNotifications(id, SERVICE_UUID, TX_UUID, (val) => {\n+\t\t\tconsole.log(dataViewToText(val)); //log all messages from the ESP32 for now\n+\t\t});\n+\t}\n+\n+\tasync function restore() {\n+\t\tawait BleClient.initialize();\n+\t\tconst [d] = await BleClient.getConnectedDevices([SERVICE_UUID]);\n+\t\tif (!d) return false;\n+\n+\t\tstate.value = \"connecting\";\n+\t\tawait BleClient.connect(d.deviceId, disconnect);\n+\t\tawait listen(d.deviceId);\n+\n+\t\tesp.value = { deviceId: d.deviceId, name: d.name };\n+\t\tstate.value = \"connected\";\n+\n+\t\tconsole.log(\"Connected to \", esp.value.deviceId);\n+\t}\n+\n+\t// reset states\n+\tfunction onDisconnect(id: string) {\n+\t\tconsole.log(\"Disconnected from\", id);\n+\t\tesp.value = null;\n+\t\tstate.value = \"idle\";\n+\t}\n+\n+\treturn { state, esp, connect, disconnect, restore };\n+});"
      },
