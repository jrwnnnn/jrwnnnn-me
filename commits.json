        "changes": 48,
        "blob_url": "https://github.com/jrwnnnn/zipo/blob/bd3146dc8d2d5599095a84e03f695fafd3fc9a19/src%2Fcomponents%2FConnectionStatus.vue",
        "raw_url": "https://github.com/jrwnnnn/zipo/raw/bd3146dc8d2d5599095a84e03f695fafd3fc9a19/src%2Fcomponents%2FConnectionStatus.vue",
        "contents_url": "https://api.github.com/repos/jrwnnnn/zipo/contents/src%2Fcomponents%2FConnectionStatus.vue?ref=bd3146dc8d2d5599095a84e03f695fafd3fc9a19",
        "patch": "@@ -0,0 +1,48 @@\n+<script setup lang=\"ts\">\n+import { useConnectivityStore } from \"@/stores/connectivity\";\n+import { onMounted } from \"vue\";\n+\n+const connectivity = useConnectivityStore();\n+onMounted(() => {\n+\tconnectivity.restore();\n+});\n+</script>\n+\n+<template>\n+\t<div class=\"my-20 flex flex-col items-center justify-center gap-5\">\n+\t\t<div\n+\t\t\tclass=\"flex w-full flex-col items-center justify-center gap-3\"\n+\t\t\t@click=\"\n+\t\t\t\tconnectivity.state == 'connected'\n+\t\t\t\t\t? connectivity.disconnect()\n+\t\t\t\t\t: connectivity.connect()\n+\t\t\t\"\n+\t\t>\n+\t\t\t<!--TODO: Replace this with 12x12 dot matrix icon or something else-->\n+\t\t\t<span\n+\t\t\t\tclass=\"aspect-square w-40\"\n+\t\t\t\t:class=\"connectivity.state == 'connected' ? 'bg-red-500' : 'bg-line'\"\n+\t\t\t>\n+\t\t\t</span>\n+\t\t\t<div class=\"text-center\">\n+\t\t\t\t<p\n+\t\t\t\t\tclass=\"font-[Geist] font-bold\"\n+\t\t\t\t\t:class=\"\n+\t\t\t\t\t\tconnectivity.state == 'connected' ? 'text-red-500' : 'text-muted'\n+\t\t\t\t\t\"\n+\t\t\t\t>\n+\t\t\t\t\t{{\n+\t\t\t\t\t\tconnectivity.state == \"connected\"\n+\t\t\t\t\t\t\t? \"Disconnect\"\n+\t\t\t\t\t\t\t: connectivity.state == \"idle\"\n+\t\t\t\t\t\t\t\t? \"Connect\"\n+\t\t\t\t\t\t\t\t: \"Connecting...\"\n+\t\t\t\t\t}}\n+\t\t\t\t</p>\n+\n+\t\t\t\t<p class=\"text-muted\">{{ connectivity.esp?.name || \"\" }}</p>\n+\t\t\t\t<p class=\"text-muted\">{{ connectivity.esp?.deviceId || \"\" }}</p>\n+\t\t\t</div>\n+\t\t</div>\n+\t</div>\n+</template>"
      },
      {
        "sha": "ef22069603eb44212f2899f93050700b7c705b49",
