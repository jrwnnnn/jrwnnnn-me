        "filename": "src/components/CommitLog.astro",
        "status": "added",
        "additions": 62,
        "deletions": 0,
        "changes": 62,
        "blob_url": "https://github.com/jrwnnnn/jrwnnnn-me/blob/2ce2b59514274a53c528ebbe4180036bbf989991/src%2Fcomponents%2FCommitLog.astro",
        "raw_url": "https://github.com/jrwnnnn/jrwnnnn-me/raw/2ce2b59514274a53c528ebbe4180036bbf989991/src%2Fcomponents%2FCommitLog.astro",
        "contents_url": "https://api.github.com/repos/jrwnnnn/jrwnnnn-me/contents/src%2Fcomponents%2FCommitLog.astro?ref=2ce2b59514274a53c528ebbe4180036bbf989991",
        "patch": "@@ -0,0 +1,62 @@\n+---\n+interface Commit {\n+  sha: string;\n+  url: string;\n+  commit: {\n+    author: {\n+      date: string;\n+    };\n+    message: string;\n+  };\n+  html_url: string;\n+  stats: {\n+    additions: number;\n+    deletions: number;\n+    total: number;\n+  };\n+  files: {\n+    filename: string;\n+  }[];\n+}\n+\n+const commits: Commit[] = await (\n+  await fetch(\n+    \"https://raw.githubusercontent.com/jrwnnnn/jrwnnnn-me/refs/heads/data/commits.json\",\n+  )\n+).json();\n+---\n+\n+<div class=\"space-y-4 font-mono text-sm\">\n+  {\n+    commits.map((commit) => (\n+      <a\n+        href={commit.html_url}\n+        target=\"_blank\"\n+        class=\"block space-y-1 border-l-3 border-green-500/40 pl-5 transition hover:border-green-500\"\n+      >\n+        <div class=\"flex items-start justify-between gap-5\">\n+          <p class=\"mb-1 line-clamp-2\">\n+            <strong>{commit.url.split(\"/\")[5]}</strong> /{\" \"}\n+            {commit.commit.message}\n+          </p>\n+        </div>\n+        <div class=\"flex items-start gap-2 text-green-800\">\n+          <p class=\"text-xs\">\n+            {new Date(commit.commit.author.date).toLocaleDateString(\"en-GB\", {\n+              day: \"2-digit\",\n+              month: \"2-digit\",\n+              year: \"numeric\",\n+            })}\n+          </p>\n+          <p> | </p>\n+          <div class=\"flex space-x-3 text-xs\">\n+            <span>+{commit.stats.additions}</span>\n+            <span>-{commit.stats.deletions}</span>\n+          </div>\n+          <p> | </p>\n+          <p class=\"text-xs\">{commit.sha.substring(0, 7)}</p>\n+        </div>\n+      </a>\n+    ))\n+  }\n+</div>"
      },
