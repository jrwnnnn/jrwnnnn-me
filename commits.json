        "patch": "@@ -1,10 +1,9 @@\n ---\n import { createClient } from \"@libsql/client\";\n-import sharp from \"sharp\";\n-import { BlobServiceClient } from \"@azure/storage-blob\";\n-import { setPosition } from \"../utils/algorithm/perlin\";\n+import { validateSubmission, isRateLimited } from \"@utils/validateForm\";\n+import { uploadImage } from \"@utils/azure\";\n import { hashSeed } from \"@utils/random\";\n-import { getRandomStar } from \"@utils/star\";\n+import { setPosition } from \"../utils/algorithm/perlin\";\n import renderStar from \"@utils/renderStar\";\n import Layout from \"@layouts/Layout.astro\";\n import Star from \"@components/Star.astro\";\n@@ -21,66 +20,30 @@ let error = \"\";\n \n if (Astro.request.method === \"POST\") {\n \tconst formData = await Astro.request.formData();\n+\tconst result = await validateSubmission(formData, Astro.clientAddress);\n \n-\tconst token = formData.get(\"recaptcha_token\");\n-\tconst recaptchaVerify = await fetch(\n-\t\t`https://www.google.com/recaptcha/api/siteverify?secret=${import.meta.env.RECAPTCHA_SECRET_KEY || process.env.RECAPTCHA_SECRET_KEY}&response=${token}`,\n-\t\t{\n-\t\t\tmethod: \"POST\",\n-\t\t},\n-\t);\n-\tconst recaptchaData = await recaptchaVerify.json();\n-\n-\tconst name = (formData.get(\"name\") as string)?.trim();\n-\tconst birthYear = (formData.get(\"birth_year\") as string)?.trim();\n-\tconst deathYear = (formData.get(\"death_year\") as string)?.trim();\n-\tconst message = (formData.get(\"message\") as string)?.trim();\n-\tconst image = formData.get(\"image\") as File;\n-\tconst star = getRandomStar();\n-\n-\tif (\n-\t\t!recaptchaData.success ||\n-\t\trecaptchaData.score < 0.5 ||\n-\t\trecaptchaData.action !== \"submit\"\n-\t) {\n-\t\terror = \"Security check failed. Please try again.\";\n-\t} else if (image && image.size > 5 * 1024 * 1024) {\n-\t\terror = \"Image must be under 5MB.\";\n-\t} else if (parseInt(birthYear) > parseInt(deathYear)) {\n-\t\terror = \"Birth year must be before death