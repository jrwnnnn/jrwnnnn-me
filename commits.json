        "patch": "@@ -1,24 +1,17 @@\n ---\n import { Image } from \"astro:assets\";\n+import CopyServerIP from \"../components/CopyServerIP.astro\";\n import Layout from \"../layouts/Layout.astro\";\n import Navigation from \"../components/Navigation.astro\";\n import PlayerList from \"../components/PlayerList.astro\";\n \n import hero from \"../assets/images/backgrounds/lush_cave.webp\";\n import map from \"../assets/images/ui/map.webp\";\n-import warning from \"../assets/images/ui/warning.webp\";\n ---\n \n <Layout title=\"Block1A\">\n \t<Navigation />\n-\t<div class=\"flex items-center justify-center gap-2 bg-red-600 py-1\">\n-\t\t<Image\n-\t\t\tsrc={warning}\n-\t\t\tclass=\"mr-2 inline w-5 invert md:w-4\"\n-\t\t\talt=\"Warning Icon\"\n-\t\t/>\n-\t\t<p class=\"text-sm font-semibold\">The server is currently offline.</p>\n-\t</div>\n+\t<CopyServerIP />\n \n \t<Image\n \t\tsrc={hero}"
