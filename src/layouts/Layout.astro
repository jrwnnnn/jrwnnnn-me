---
import "../styles/global.css";
import socials from "../data/socials.json";

interface Props {
	title: string;
	description?: string;
	statusBar?: boolean;
	footer?: boolean;
}

const {
	title,
	description = "Default Description",
	statusBar = true,
	footer = true,
} = Astro.props;

let errorPayload;
const latestCommit = await fetch(
	"https://raw.githubusercontent.com/jrwnnnn/jrwnnnn-me/refs/heads/data/jrwnnnn-me-commits.json",
)
	.then((r) =>
		r.ok
			? r.json()
			: Promise.reject(
					new Error(
						`Failed to load page's latest commit returned status ${r.status}`,
					),
				),
	)
	.catch((e) => {
		errorPayload = e;
		return [];
	});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.svg" />
		<!-- TODO: Metadata -->
		<title>Mark Jerwin // {title}</title>
	</head>
	<body>
		{
			statusBar ? (
				<div class="fixed top-0 left-0 z-40 flex w-full items-center justify-between border-b border-green-800 bg-green-900/20 px-5 py-1 text-xs backdrop-blur-sm">
					<div class="flex gap-4">
						<span>[ CONNECTED ]</span>
						<span>USER: GUEST</span>
					</div>
					<div>
						<span id="live-clock" />
					</div>
				</div>
			) : null
		}

		<script>
			function updateTime() {
				const liveClock = document.getElementById("live-clock");
				if (!liveClock) return;
				const now = new Date();
				const timeString = now.toLocaleTimeString([], { hour12: false });
				liveClock.textContent = timeString;
			}
			updateTime();
			setInterval(updateTime, 1000);
		</script>

		<slot />

		{
			footer ? (
				<footer class="mt-20">
					<div class="z-0] flex justify-end px-5 md:px-20 lg:px-30">
						<span
							class="relative cursor-pointer bg-green-500 px-3 font-bold text-black transition-all hover:top-0 md:px-2 lg:top-5"
							onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
						>
							<span class="text-2xl lg:hidden">↑</span>
							<span class="hidden font-mono lg:inline">Back to Top</span>
						</span>
					</div>

					<div class="relative z-1 flex items-center justify-between border-t border-green-900/30 bg-black px-5 py-8 text-xs md:px-20 lg:px-30">
						<div class="flex flex-col space-x-5 md:flex-row">
							<p class="font-mono font-bold">© 2026 Mark Jerwin</p>
							{!errorPayload && (
								<>
									<p class="hidden font-mono md:block">-</p>
									<a
										class="flex cursor-pointer items-center gap-2 opacity-75 hover:underline"
										href={latestCommit[0].html_url}
										target="_blank"
									>
										<img
											class="h-4 object-contain"
											src="icons/git-commit.svg"
											loading="lazy"
											alt="Git Commit"
										/>
										<p class="mt-0.5 font-mono">
											{latestCommit[0].sha.slice(0, 7)}
										</p>
									</a>
								</>
							)}
						</div>
						<div class="flex items-center space-x-5">
							{socials.map((social) => (
								<a href={social.href} target="_blank" class="cursor-pointer">
									<img
										class="h-5 object-contain"
										src={social.icon}
										loading="lazy"
										alt={social.name + " Icon"}
									/>
								</a>
							))}
						</div>
					</div>
				</footer>
			) : null
		}

		<svg class="hidden">
			<filter id="phosphor-overlay">
				<feColorMatrix
					type="matrix"
					values="0.33 0.33 0.33 0 0 
							0.33 0.33 0.33 0 0 
							0.33 0.33 0.33 0 0 
							0 0 0 1 0"
				></feColorMatrix>
				<feComponentTransfer>
					<feFuncR type="linear" slope="0.13"></feFuncR>
					<feFuncG type="linear" slope="0.77"></feFuncG>
					<feFuncB type="linear" slope="0.36"></feFuncB>
				</feComponentTransfer>
			</filter>
		</svg>

		<script src="../scripts/glitchFX.ts"></script>
	</body>
</html>
