---
interface Props {
	title: string;
	description?: string;
	statusBar?: boolean;
	footer?: boolean;
}

import "../styles/global.css";
const { title, description = "Default Description", statusBar = true, footer = true} = Astro.props;
const latestCommit = await(await fetch('https://raw.githubusercontent.com/jrwnnnn/jrwnnnn-me/refs/heads/data/jrwnnnn-me-commits.json')).json();
const socials = [
  {
    icon: "icons/socials/github.svg",
    href: "https://github.com/jrwnnnn",
	name: "Github",
  },
  {
    icon: "icons/socials/gmail.svg",
    href: "mailto:no_email_yet@gmail.com",
	name: "Email"
  },
  {
    icon: "icons/socials/instagram.svg",
    href: "https://instagram.com/jrwnnn_",
	name: "Instagram"
  },
];
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.svg">
		<!-- TODO: Metadata -->
		<title>Mark Jerwin // {title}</title>
	</head>
	<body>
		{statusBar ?
			<div class="flex fixed top-0 left-0 z-40 justify-between items-center py-1 px-5 w-full text-xs border-b border-green-800 bg-green-900/20 backdrop-blur-sm">
				<div class="flex gap-4">
					<span>[ CONNECTED ]</span>
					<span>USER: GUEST</span>
				</div>
				<div>
					<span id="live-clock"></span>
					<script>
						function updateTime() {
							const now = new Date();
							const timeString = now.toLocaleTimeString([], { hour12: false });
							document.getElementById('live-clock')!.textContent = timeString;
						}
						updateTime();
						setInterval(updateTime, 1000);
					</script>
				</div>
			</div>
			: null
		}

		<slot />

		{footer ?
			<footer class="mt-20">
				<div class="flex justify-end px-5 md:px-20 lg:px-30 z-0]">
					<span 
						class="relative lg:top-5 bg-green-500 font-bold md:px-2 px-3 hover:top-0 transition-all cursor-pointer text-black" 
						onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
					>
						<span class="lg:hidden text-2xl">↑</span>
						<span class="hidden lg:inline font-mono">Back to Top</span>
					</span>
				</div>

				<div class="flex items-center justify-between border-t border-green-900/30 bg-black px-5 py-8 text-xs md:px-20 lg:px-30 relative z-1">
					<div class="flex flex-col space-x-5 md:flex-row">
						<p class="font-mono font-bold">© 2026 Mark Jerwin</p>
						<p class="hidden font-mono md:block">-</p>
						<a 
							class="flex items-center gap-2 opacity-75 cursor-pointer hover:underline" 
							href={latestCommit[0].html_url} 
							target="_blank"
						>
							<img
								class="h-4 object-contain"
								src="icons/git-commit.svg"
								loading="lazy"
								alt="Git Commit"
							/>
							<p class="mt-0.5 font-mono">{latestCommit[0].sha.slice(0, 7)}</p>
						</a>
					</div>
					<div class="flex items-center space-x-5">
						{
							socials.map((social) => (
								<a href={social.href} target="_blank" class="cursor-pointer">
									<img
										class="h-5 object-contain"
										src={social.icon}
										loading="lazy"
										alt=`${social.name} Icon`
									/>
								</a>
							))
						}
					</div>
				</div>
			</footer>
		: null 
		}

		<svg class="hidden">
			<filter id="phosphor-overlay">
				<feColorMatrix
					type="matrix"
					values="0.33 0.33 0.33 0 0 
							0.33 0.33 0.33 0 0 
							0.33 0.33 0.33 0 0 
							0 0 0 1 0"
				></feColorMatrix>
				<feComponentTransfer>
					<feFuncR type="linear" slope="0.13"></feFuncR>
					<feFuncG type="linear" slope="0.77"></feFuncG>
					<feFuncB type="linear" slope="0.36"></feFuncB>
				</feComponentTransfer>
			</filter>
		</svg>

		<script src="../scripts/glitchFX.ts"></script>
	</body>
</html>