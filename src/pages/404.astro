---
import { env } from "cloudflare:workers";
import Ascii from "@/components/AsciiContainer.astro";
import Layout from "@/layouts/Layout.astro";
import largeAscii from "@/assets/ascii/404_large.txt?raw";
import smallAscii from "@/assets/ascii/404_small.txt?raw";
---

<Layout title="Mark Jerwin // 404" footer={false} robots="noindex, nofollow">
	<main class="flex flex-col justify-between gap-5 overflow-clip">
		<div class="space-y-5">
			<p class="text-5xl font-bold tracking-widest">&gt; 404_ERROR</p>
			<div class="text-primary/80 space-y-5 font-mono text-sm">
				<p class="md:max-w-2/3">
					&gt; <span class="font-bold">FATAL EXCEPTION:</span> The requested frequency
					is receiving static. The page you are looking for might have been moved,
					deleted, or never existed in this timeline.
				</p>
			</div>
		</div>
		<div class="strech glitch">
			<Ascii ascii={largeAscii} class="hidden md:block" />
			<Ascii ascii={smallAscii} class="md:hidden" />
		</div>
	</main>
</Layout>
