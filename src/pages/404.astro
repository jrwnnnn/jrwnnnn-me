---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import Ascii from "../components/AsciiContainer.astro";

const art = await env.SESSION.get(["404.art", "404.art.small"]);
---

<Layout title="Mark Jerwin // 404" footer={false} robots="noindex, nofollow">
	<main class="flex flex-col gap-5 overflow-clip justify-between">
		<div class="space-y-5">
			<p class="text-5xl font-bold tracking-widest text-green-500">
				&gt; 404_ERROR
			</p>
			<div class="space-y-5 font-mono text-sm text-green-500/80">
				<p class="md:max-w-2/3">
					&gt; <span class="font-bold">FATAL EXCEPTION:</span> The requested
					frequency is receiving static. The page you are looking for might have been
					moved, deleted, or never existed in this timeline.
				</p>
			</div>
		</div>
		<div class="strech glitch">
			<Ascii ascii={art.get("404.art") as string} class="hidden md:block" />
			<Ascii ascii={art.get("404.art.small") as string} class="md:hidden" />
		</div>
	</main>
</Layout>
