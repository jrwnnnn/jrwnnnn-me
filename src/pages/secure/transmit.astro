---
import "../../styles/marked.css";
import { createHash } from "node:crypto";
import { env } from "cloudflare:workers";
import Layout from "../../layouts/Layout.astro";

const action = Astro.url.searchParams.get("action") ?? "create";
let transmissionContent;

if (action == "edit") {
	transmissionContent = await env.DB.prepare(
		"SELECT * FROM articles WHERE slug = ? LIMIT 1",
	)
		.bind(Astro.url.searchParams.get("slug"))
		.all();

	if (transmissionContent.results.length === 0) {
		return new Response(null, { status: 404 });
	}
}

if (Astro.request.method === "POST") {
	const data = await Astro.request.formData();
	const title = data.get("title")?.toString() ?? "";
	const subtitle = data.get("subtitle")?.toString() ?? null;
	const tags = data.get("tags")?.toString() ?? null;
	const content = data.get("content")?.toString() ?? "";

	if (action === "create") {
		const slug = createHash("md5")
			.update(title + Date.now())
			.digest("hex")
			.substring(0, 10);

		await env.DB.prepare(
			"INSERT INTO articles (title, subtitle, tags, content, slug) VALUES (?, ?, ?, ?, ?)",
		)
			.bind(title, subtitle, tags, content, slug)
			.run();

		return new Response(null, {
			status: 302,
			headers: { Location: `/transmission/${slug}` },
		});
	} else if (action === "edit") {
		await env.DB.prepare(
			"UPDATE articles SET title = ?, subtitle = ?, tags = ?, content = ? WHERE slug = ?",
		)
			.bind(
				title,
				subtitle,
				tags,
				content,
				transmissionContent!.results[0].slug,
			)
			.run();

		return new Response(null, {
			status: 302,
			headers: {
				Location: `/transmission/${transmissionContent.results[0].slug}`,
			},
		});
	}
}
---

<Layout title="Mark Jerwin // TRANSMIT" robots="noindex, nofollow">
	<main class="flex flex-col items-center justify-center">
		<svg
			id="preview-toggle"
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			fill="#000"
			stroke="#00c951"
			width="30"
			height="30"
			class="mb-10 cursor-pointer"
		>
			<path
				d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
			></path>
		</svg>

		<div class="w-full font-mono md:w-[60vw]">
			<statusbar
				class="flex items-center justify-between border border-b-0 border-green-800 bg-green-900/20 px-4 py-2 text-xs tracking-widest uppercase"
			>
				<span>PREVIEW</span>

				<time datetime={new Date().toISOString()}>
					{
						new Date().toLocaleDateString("en-US", {
							year: "numeric",
							month: "short",
							day: "numeric",
						})
					}
				</time>
			</statusbar>

			<form
				id="main-form"
				method="POST"
				class="flex flex-col space-y-5 border border-green-800 bg-black p-6 md:p-12"
			>
				<textarea
					id="title-input"
					name="title"
					placeholder="Title"
					rows="1"
					class="w-full resize-none text-4xl leading-none font-bold uppercase outline-none md:text-5xl"
					required
					>{
						action === "edit" ? transmissionContent!.results[0].title : ""
					}</textarea
				>

				<textarea
					id="subtitle-input"
					name="subtitle"
					placeholder="Subtitle"
					rows="2"
					class="h-full w-full resize-none text-lg text-green-600 outline-none"
					required
					>{
						action === "edit" ? transmissionContent!.results[0].subtitle : ""
					}</textarea
				>

				<input
					id="tags-input"
					type="text"
					name="tags"
					placeholder="Tags (optional, comma-separated)"
					value={`${action === "edit" ? transmissionContent!.results[0].tags : ""}`}
					class="w-full resize-none overflow-hidden font-mono whitespace-pre text-green-500 outline-none"
				/>

				<hr class="border border-green-900/50" />

				<textarea
					id="content-input"
					class="h-full min-h-30 w-full resize-none overflow-hidden outline-none"
					name="content"
					placeholder="Start typing here..."
					>{
						action === "edit" ? transmissionContent!.results[0].content : ""
					}</textarea
				>

				<div id="preview-container" class="prose hidden min-h-30"></div>

				<hr class="border border-green-900/50" />

				<p class="text-center text-sm text-green-800 italic">
					END OF TRANSMISSION
				</p>

				<button
					type="submit"
					class="cursor-pointer self-end px-3 py-2 text-sm font-bold tracking-widest hover:bg-green-500 hover:text-black hover:brightness-110"
				>
					[ TRANSMIT ]
				</button>
			</form>
		</div>
	</main>
</Layout>

<script>
	import { marked } from "marked";
	const toggle = document.getElementById("preview-toggle");
	const input = document.getElementById("content-input") as HTMLTextAreaElement;
	const preview = document.getElementById("preview-container");

	if (toggle && input && preview) {
		toggle.addEventListener("click", async () => {
			const isEditing = !input.classList.contains("hidden");

			if (isEditing) preview.innerHTML = await marked.parse(input.value);
			input.classList.toggle("hidden", isEditing);
			preview.classList.toggle("hidden", !isEditing);
			toggle.setAttribute("fill", isEditing ? "#00c951" : "#000");
			toggle.setAttribute("stroke", isEditing ? "#000" : "#00c951");
		});
	}

	function autoResize(textArea: HTMLTextAreaElement) {
		const scrollY = window.scrollY;
		textArea.style.height = "auto";
		textArea.style.height = textArea.scrollHeight + "px";
		window.scrollTo({ top: scrollY, behavior: "instant" });
	}

	document.querySelectorAll("textarea").forEach((element) => {
		autoResize(element as HTMLTextAreaElement);
		element.addEventListener("input", () =>
			autoResize(element as HTMLTextAreaElement),
		);
	});
</script>
