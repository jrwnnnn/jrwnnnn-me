---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Mark Jerwin // SHELL" footer={false}>
	<main>
		<div id="output" class="font-mono">
			<p>Welcome to the shell. Type "help" for a list of commands.</p>
		</div>
		<form id="input-form" class="flex gap-2 font-mono">
			<p>user@host:~$</p>
			<textarea
				id="input"
				autocapitalize="off"
				autocomplete="off"
				autocorrect="off"
				autofocus
				class="w-full resize-none overflow-hidden leading-6 outline-none"
				oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'"
				rows="1"
				spellcheck="false"></textarea>
		</form>
	</main>
</Layout>

<script>
	const output = document.getElementById("output");
	const form = document.getElementById("input-form");
	const input = document.getElementById("input") as HTMLTextAreaElement;

	import { echo, help, ping, sudo } from "../../lib/shell/common.ts";
	import { cd } from "../../lib/shell/cd.ts";

	const handlers: Record<
		string,
		(args: string[]) => HTMLElement | Promise<HTMLElement>
	> = {
		echo,
		help,
		cd,
		ping,
		sudo,
	};

	function appendCommand(command: string) {
		const p = document.createElement("p");
		p.textContent = `user@host:~$ ${command}`;
		output!.appendChild(p);
	}

	function notFound(command: string): HTMLElement {
		const p = document.createElement("p");
		p.textContent = `Unknown command '${command}'`;
		p.classList.add("text-red-500");
		return p;
	}

	input.addEventListener("keydown", async (e) => {
		if (e.key === "Enter" && !e.shiftKey) {
			e.preventDefault();
			const raw = input.value.trim();
			if (!raw) return;
			input.value = "";
			form!.classList.toggle("hidden");
			appendCommand(raw);
			const [cmd, ...args] = raw.split(" ");
			const handler = handlers[cmd];
			const result = await (handler ? handler(args) : notFound(cmd));
			setTimeout(() => {
				output!.appendChild(result);
				form!.classList.toggle("hidden");
			}, 400);
		}
	});
</script>
