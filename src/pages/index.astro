---
import { env } from "cloudflare:workers";
import Ascii from "../components/AsciiContainer.astro";
import CommitLog from "../components/CommitLog.astro";
import Container from "../components/Container.astro";
import Heatmap from "../components/Heatmap.astro";
import LastFM from "../components/Scrobble.jsx";
import Layout from "../layouts/Layout.astro";

import socials from "../data/socials.json";
import themes from "../data/themes.json";

const latestTransmission = await env.DB.prepare(
	"SELECT title, subtitle, slug, date_created FROM articles ORDER BY date_created DESC LIMIT 1",
).all();
const siteSettings = await env.SESSION.get(["index.quote", "index.art"]);

const stack = [
	{ icon: "icons/stack/javascript.svg", name: "JavaScript" },
	{ icon: "icons/stack/astro.svg", name: "Astro" },
	{ icon: "icons/stack/php.svg", name: "PHP" },
	{ icon: "icons/stack/react.svg", name: "React" },
	{ icon: "icons/stack/tailwindcss.svg", name: "Tailwind CSS" },
	{ icon: "icons/stack/mariadb.svg", name: "MariaDB" },
];
---

<Layout title="Mark Jerwin // BOOT">
	<main class="flex flex-col space-y-10">
		<div class="space-y-15">
			<div class="mt-15 space-y-5">
				<p
					class="text-shadow-primary/50 text-5xl tracking-wider text-balance text-shadow-lg md:text-6xl"
				>
					Hello! It's Jerwin
				</p>
				<p class="font-mono md:w-2/3 md:text-lg">
					I'm a student based in <strong>Manila, PH</strong>. I build things for
					the <strong>web</strong>. My code is held together by duct tape and
					prayers. I spend more time customizing my VS Code theme than actually
					coding. If you see a bug, no you didn't.
				</p>
				<div class="flex cursor-pointer items-center space-x-9">
					{
						socials.map((social) => (
							<a
								href={social.href}
								target="_blank"
								class="flex items-center space-x-2 hover:brightness-125"
							>
								<span
									class="bg-primary inline-block h-5 w-5"
									style={`-webkit-mask: url(${social.icon}) no-repeat center; mask: url(${social.icon}) no-repeat center; mask-size: contain;`}
								/>
								<p class="font-mono">{social.name}</p>
							</a>
						))
					}
				</div>
			</div>
			<Container
				class="shadow-primary/50 hover:shadow-lg"
				onclick={`location.href='/transmission/${latestTransmission.results[0].slug}'`}
			>
				<p class="font-mono text-lg font-bold tracking-widest uppercase">
					{latestTransmission.results[0].title}
				</p>
				<p class="text-primary/75 line-clamp-1 font-mono">
					<span>
						{
							new Date(
								latestTransmission.results[0].date_created as string,
							).toLocaleDateString("en-US", {
								year: "numeric",
								month: "short",
								day: "numeric",
							})
						}
					</span>
					- {latestTransmission.results[0].subtitle}
				</p>
			</Container>
		</div>
		<section class="space-y-5">
			<h3 class="text-xl font-bold tracking-widest">&gt; MAIN_MENU</h3>
			<div class="grid grid-cols-1 gap-6 font-mono font-bold lg:grid-cols-3">
				<div class="button group" onclick="location.href='projects'">
					<span class="mr-2 group-hover:animate-ping">&gt; </span> [ DIR ] PROJECTS
				</div>
				<div class="button group" onclick="location.href='transmission'">
					<span class="mr-2 group-hover:animate-ping">&gt; </span> [ LOG ] TRANSMISSION_LOG
				</div>
				<div class="button group" onclick="location.href='gallery'">
					<span class="mr-2 group-hover:animate-ping">&gt; </span> [ PCX ] GALLERY
				</div>
			</div>
		</section>
		<section class="columns-1 gap-6 space-y-6 lg:columns-2">
			<Container
				class="shadow-primary/50 break-inside-avoid space-y-5 bg-black! transition-shadow hover:shadow-lg"
			>
				<p class="text-lg font-bold tracking-widest">&gt; STACK</p>
				<hr class="border-primary/40 border" />
				<div
					class="grid grid-cols-3 place-items-center gap-4 brightness-90 md:grid-cols-5"
				>
					{
						stack.map((language) => (
							<div class="flex flex-col items-center gap-2">
								<span
									class="bg-primary h-10 w-10 lg:w-12"
									style={`mask: url('${language.icon}') no-repeat center / contain; -webkit-mask: url('${language.icon}') no-repeat center / contain;`}
								/>
								<p class="font-mono text-sm">{language.name}</p>
							</div>
						))
					}
				</div>
			</Container>
			<Container
				class="shadow-primary/50 break-inside-avoid space-y-5 bg-black! transition-shadow hover:shadow-lg"
			>
				<p class="text-lg font-bold tracking-widest">&gt; COMMIT_LOG</p>
				<hr class="border-primary/40 border" />
				<CommitLog />
				<Heatmap />
			</Container>
			<Container
				class="shadow-primary/50 break-inside-avoid space-y-5 bg-black! transition-shadow hover:shadow-lg"
			>
				<LastFM client:idle />
			</Container>
			<Container
				class="shadow-primary/50 break-inside-avoid space-y-5 bg-black! transition-shadow hover:shadow-lg"
			>
				<Ascii
					ascii={siteSettings.get("index.art") as string}
					class="glitch opacity-90"
				/>
				<hr class="border-primary/40 border" />
				<p class="text-center font-mono text-sm italic">
					{siteSettings.get("index.quote")}
				</p>
			</Container>
		</section>
	</main>
</Layout>

<style>
	@reference "../styles/global.css";

	.button {
		@apply border-primary hover:bg-primary focus:bg-primary shadow-primary/50 cursor-pointer border p-3 text-left hover:text-black hover:shadow-lg;
	}
</style>

<script>
	document
		.querySelectorAll<HTMLElement>("[data-selected-theme]")
		.forEach((element) => {
			element.addEventListener("click", () => {
				const theme = element.dataset.selectedTheme!;
				document.documentElement.dataset.theme = theme;
				localStorage.setItem("theme", theme);
			});
		});
</script>
