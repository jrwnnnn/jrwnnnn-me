---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import Ascii from "../components/AsciiContainer.astro";
import CommitLog from "../components/CommitLog.astro";
import LastFM from "../components/Scrobble.astro";

const title = await (await fetch("https://pastebin.com/raw/K1GufLfn")).text();
const asciiArt = await (
  await fetch("https://pastebin.com/raw/2w7sZxex")
).text();
const js = await (await fetch("https://pastebin.com/raw/f3mNJJkE")).text();
---

<Layout title="BOOT">
  <main class="flex flex-col space-y-8">
    <div class="mt-15 space-y-5 md:w-2/3">
      <p class="text-5xl text-balance md:text-6xl">Ni Howdy! It's Jerwin</p>
      <p class="text-md font-mono">
        I'm a student based in <strong>Manila, PH</strong>. I build things for
        the <strong>web</strong>. My code is held together by duct tape and
        prayers. I spend more time customizing my VS Code theme than actually
        coding. If you see a bug, no you didn't.
      </p>
    </div>
    <Container class="space-y-2" onclick="location.href='blog?=latest'">
      <p class="text-lg font-bold tracking-widest">> LATEST_TRANSMISSION</p>
      <div class="flex items-center font-mono text-sm">
        <span class="mr-2 bg-green-500 px-1 text-xs font-bold text-black"
          >ENCRYPTED</span
        >
        <span
          id="latest_transmission"
          class="line-clamp-2 cursor-pointer text-green-500 opacity-80"
          >░█░█░▄▀▄░█░█░░░░░█▀▀░█▀▄░█▀▄░█▀█░█▀▄░░▀█░█/█░░▀█░░░░░█▀▀░█▀▄░█▀▄░█░█░█▀▄░░░▀░░▀░░░░▀░▀▀▀░▀▀▀░▀░▀░▀░▀░▀▀▀░▀░▀</span
        >
        <script>
          const e = document.getElementById("latest_transmission"),
            c = "░█▓▒▀▄▌▐",
            l = e!.innerText.length;
          setInterval(
            () =>
              (e!.innerText = [...Array(l)]
                .map(() => c[Math.floor(Math.random() * c.length)])
                .join("")),
            100,
          );
        </script>
      </div>
      <p class="font-mono text-xs font-bold">[ DATE RECIEVED: 2026-01-27 ]</p>
    </Container>
    <hr class="border-green-500" />
    <div class="space-y-5">
      <h3 class="text-xl font-bold tracking-widest">> MAIN_MENU</h3>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <Button
          class="group py-3! text-left"
          onclick="location.href='projects'"
        >
          <span class="mr-2 group-hover:animate-ping">></span> [ DIR ] PROJECTS
        </Button>
        <Button class="group py-3! text-left" onclick="location.href='blog'">
          <span class="mr-2 group-hover:animate-ping">></span> [ LOG ] BLOGS
        </Button>
      </div>
    </div>
    <div class="columns-1 gap-6 space-y-6 lg:columns-2">
      <Container class="break-inside-avoid space-y-5">
        <Ascii ascii={asciiArt} class="glitch" />
      </Container>
      <Container class="break-inside-avoid space-y-5">
        <p class="text-lg font-bold tracking-widest">> STACK</p>
        <!-- TODO: This is pretty meaningless -->
        <canvas class="border-y border-green-500/30" id="stackradar"></canvas>
        <div class="grid grid-cols-3 place-items-center gap-4 md:grid-cols-5">
          <div class="flex flex-col items-center gap-2">
            <img
              class="h-10 w-10 object-contain"
              src="icons/stack/javascript.svg"
              loading="lazy"
              alt="JavaScript"
            />
            <p class="font-mono text-xs font-bold">JavaScript</p>
          </div>
          <div class="flex flex-col items-center gap-2">
            <img
              class="h-10 w-10 object-contain"
              src="icons/stack/astro.svg"
              loading="lazy"
              alt="Astro"
            />
            <p class="font-mono text-xs font-bold">Astro</p>
          </div>
          <div class="flex flex-col items-center gap-2">
            <img
              class="h-10 w-10 object-contain"
              src="icons/stack/php.svg"
              loading="lazy"
              alt="PHP"
            />
            <p class="font-mono text-xs font-bold">PHP</p>
          </div>
          <div class="flex flex-col items-center gap-2">
            <img
              class="h-10 w-10 object-contain"
              src="icons/stack/react.svg"
              loading="lazy"
              alt="React"
            />
            <p class="font-mono text-xs font-bold">React</p>
          </div>
          <div class="flex flex-col items-center gap-2">
            <img
              class="h-10 w-10 object-contain"
              src="icons/stack/tailwindcss.svg"
              loading="lazy"
              alt="Tailwind CSS"
            />
            <p class="font-mono text-xs font-bold">Tailwind CSS</p>
          </div>
        </div>
        <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <!-- TODO Move this huge ass jsob blob out of here -->
        <script is:inline>
          const ctx = document.getElementById("stackradar");
          new Chart(ctx, {
            type: "radar",
            data: {
              labels: ["Astro", "JavaScript", "PHP", "React", "CSS"],
              datasets: [
                {
                  data: [5, 5, 8, 3, 9],
                  backgroundColor: "rgba(0, 201, 80, 0.2)",
                  borderColor: "#00C950",
                  borderWidth: 2,
                  pointBackgroundColor: "#00C950",
                  pointBorderColor: "#00C950",
                },
              ],
            },
            options: {
              responsive: true,
              maintainAspectRatio: true,
              scales: {
                r: {
                  min: 0,
                  max: 10,
                  angleLines: { color: "#00C95050" },
                  grid: { color: "#00C95030" },
                  pointLabels: {
                    color: "#00C950",
                    font: { family: "monospace", size: 12, weight: "bold" },
                  },
                  ticks: { display: false },
                },
              },
              plugins: {
                legend: { display: false },
                tooltip: { enabled: false },
              },
            },
          });
        </script>
      </Container>
      <Container class="break-inside-avoid space-y-5">
        <p class="text-lg font-bold tracking-widest">> COMMIT_LOG</p>
        <hr class="border border-green-500/30" />
        <CommitLog />
        <!-- TODO: Add heat map -->
      </Container>
      <Container class="break-inside-avoid space-y-4">
        <p class="text-lg font-bold tracking-widest">> LAST_FM</p>
        <hr class="border border-green-500/30" />
        <LastFM />
      </Container>
    </div>
  </main>
</Layout>
