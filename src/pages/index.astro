---
import { createClient } from "@libsql/client";

import Layout from "../layouts/Layout.astro";
import ErrorOut from "../components/ErrorOut.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import Ascii from "../components/AsciiContainer.astro";

import CommitLog from "../components/modules/CommitLog.astro";
import Heatmap from "../components/modules/Heatmap.astro";
import LastFM from "../components/modules/Scrobble.jsx";

import socials from "../data/socials.json";

const turso = createClient({
	url: process.env.TURSO_DATABASE_URL || import.meta.env.TURSO_DATABASE_URL,
	authToken: process.env.TURSO_AUTH_TOKEN || import.meta.env.TURSO_AUTH_TOKEN,
});

const art = await turso.execute(
	"SELECT value FROM site_settings WHERE key = 'index.art'",
);

let errorPayload, asciiArt = "";
if (typeof art.rows[0].value === "string") {
	asciiArt = await fetch(art.rows[0].value)
		.then((r) =>
			r.ok
				? r.text()
				: Promise.reject(
						new Error(`Failed to load ASCII Art returned status ${r.status}`),
					),
		)
		.catch((e) => {
			errorPayload = e;
			return "";
		});
} else {
	errorPayload = new Error("Failed to load ASCII Art returned status: Invalid");
}

const stack = [
	{ icon: "icons/stack/javascript.svg", name: "JavaScript" },
	{ icon: "icons/stack/astro.svg", name: "Astro" },
	{ icon: "icons/stack/php.svg", name: "PHP" },
	{ icon: "icons/stack/react.svg", name: "React" },
	{ icon: "icons/stack/tailwindcss.svg", name: "Tailwind CSS" },
	{ icon: "icons/stack/mariadb.svg", name: "MariaDB" },
];
---

<Layout title="Mark Jerwin // BOOT">
	<main class="flex flex-col space-y-8">
		<section class="space-y-15">
			<div class="mt-15 space-y-5 lg:w-2/3">
				<p class="text-5xl text-balance md:text-6xl">Hello! It's Jerwin</p>
				<p class="font-mono md:text-lg">
					I'm a student based in <strong>Manila, PH</strong>. I build things for
					the <strong>web</strong>. My code is held together by duct tape and
					prayers. I spend more time customizing my VS Code theme than actually
					coding. If you see a bug, no you didn't.
				</p>
				<div class="flex cursor-pointer items-center space-x-9">
					{
						socials.map((social) => (
							<a
								href={social.href}
								target="_blank"
								class="flex items-center space-x-2 hover:brightness-125"
							>
								<img
									class="h-5 object-contain"
									src={social.icon}
									loading="eager"
									alt={`${social.name} Icon`}
								/>
								<p class="font-mono">{social.name}</p>
							</a>
						))
					}
				</div>
			</div>
			<Container class="space-y-2" onclick="location.href='blog?=latest'">
				<p class="text-lg font-bold tracking-widest">> LATEST_TRANSMISSION</p>
				<div class="flex items-center text-sm">
					<span
						class="mr-2 bg-green-500 px-1 font-mono text-xs font-bold text-black"
						>ENCRYPTED</span
					>
					<span
						id="latest_transmission"
						class="line-clamp-2 cursor-pointer text-green-500 opacity-80"
						>░█░█░▄▀▄░█░█░░░░░█▀▀░█▀▄░█▀▄░█▀█░█▀▄░░▀█░█/█░░▀█░░░░░█▀▀░█▀▄░█▀▄░█░█░█▀▄░░░▀░░▀░░░░▀░▀▀▀░▀▀▀░▀░▀░▀░▀░▀▀▀░▀░▀</span
					>
					<script>
						const e = document.getElementById("latest_transmission"),
							c = "░█▓▒▀▄▌▐",
							l = e!.innerText.length;
						setInterval(
							() =>
								(e!.innerText = [...Array(l)]
									.map(() => c[Math.floor(Math.random() * c.length)])
									.join("")),
							100,
						);
					</script>
				</div>
				<p class="font-mono text-xs text-green-700">
					[ DATE RECIEVED: 2026-01-27 ]
				</p>
			</Container>
		</section>
		<hr class="border-green-500" />
		<section class="space-y-5">
			<h3 class="text-xl font-bold tracking-widest">> MAIN_MENU</h3>
			<div class="grid grid-cols-1 gap-6 font-mono font-bold lg:grid-cols-3">
				<Button
					class="group py-3! text-left"
					onclick="location.href='projects'"
				>
					<span class="mr-2 group-hover:animate-ping">></span> [ DIR ] PROJECTS
				</Button>
				<Button class="group py-3! text-left" onclick="location.href='blog'">
					<span class="mr-2 group-hover:animate-ping">></span> [ LOG ] BLOGS
				</Button>
				<Button class="group py-3! text-left" onclick="location.href='gallery'">
					<span class="mr-2 group-hover:animate-ping">></span> [ PCX ] GALLERY
				</Button>
			</div>
		</section>
		<section class="columns-1 gap-6 space-y-6 lg:columns-2">
			<Container class="break-inside-avoid space-y-5">
				<p class="text-lg font-bold tracking-widest">> STACK</p>
				<hr class="border border-green-500/30" />
				<div
					class="grid grid-cols-3 place-items-center gap-4 brightness-90 md:grid-cols-5"
				>
					{
						stack.map((language) => (
							<div class="flex flex-col items-center gap-2">
								<img
									class="lag:w-13 h-10 w-10 object-contain lg:h-13"
									src={language.icon}
									loading="lazy"
									alt={language.name}
								/>
								<p class="font-mono text-xs font-bold">{language.name}</p>
							</div>
						))
					}
				</div>
			</Container>
			<Container class="break-inside-avoid space-y-5">
				<p class="text-lg font-bold tracking-widest">> COMMIT_LOG</p>
				<hr class="border border-green-500/30" />
				<CommitLog />
				<Heatmap />
			</Container>
			<Container class="break-inside-avoid space-y-5">
				<LastFM client:idle />
			</Container>
			<Container class="break-inside-avoid space-y-5">
				{
					errorPayload ? (
						<ErrorOut error={errorPayload} />
					) : (
						<Ascii ascii={asciiArt} class="glitch opacity-90" />
					)
				}
			</Container>
		</section>
	</main>
</Layout>
