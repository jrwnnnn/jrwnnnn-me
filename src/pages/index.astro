---
import { createClient } from "@tursodatabase/serverless/compat";
import { env } from "cloudflare:workers";
import { safeAsync } from "@utils/safeAsync";
import Ascii from "../components/AsciiContainer.astro";
import Button from "../components/Button.astro";
import CommitLog from "../components/modules/CommitLog.astro";
import Container from "../components/Container.astro";
import ErrorOut from "../components/ErrorOut.astro";
import Heatmap from "../components/modules/Heatmap.astro";
import LastFM from "../components/modules/Scrobble.jsx";
import Layout from "../layouts/Layout.astro";

import socials from "../data/socials.json";

const turso = createClient({
	url: import.meta.env.TURSO_DATABASE_URL,
	authToken: import.meta.env.TURSO_AUTH_TOKEN,
});

const siteSettings = await env.SESSION.get(["index.quote", "index.art"]);
const stack = [
	{ icon: "icons/stack/javascript.svg", name: "JavaScript" },
	{ icon: "icons/stack/astro.svg", name: "Astro" },
	{ icon: "icons/stack/php.svg", name: "PHP" },
	{ icon: "icons/stack/react.svg", name: "React" },
	{ icon: "icons/stack/tailwindcss.svg", name: "Tailwind CSS" },
	{ icon: "icons/stack/mariadb.svg", name: "MariaDB" },
];
---

<Layout title="Mark Jerwin // BOOT">
	<main class="flex flex-col space-y-8">
		<section class="space-y-15">
			<div class="mt-15 space-y-5 lg:w-2/3">
				<p class="text-5xl tracking-wider text-balance md:text-6xl">
					Hello! It's Jerwin
				</p>
				<p class="font-mono md:text-lg">
					I'm a student based in <strong>Manila, PH</strong>. I build things for
					the <strong>web</strong>. My code is held together by duct tape and
					prayers. I spend more time customizing my VS Code theme than actually
					coding. If you see a bug, no you didn't.
				</p>
				<div class="flex cursor-pointer items-center space-x-9">
					{
						socials.map((social) => (
							<a
								href={social.href}
								target="_blank"
								class="flex items-center space-x-2 hover:brightness-125"
							>
								<img
									class="h-5 object-contain"
									src={social.icon}
									loading="eager"
									alt={`${social.name} Icon`}
								/>
								<p class="font-mono">{social.name}</p>
							</a>
						))
					}
				</div>
			</div>
			{
				latestTransmission.data ? (
					<Container
						onclick={`location.href='/transmission/${latestTransmission.data.rows[0].slug}'`}
					>
						<p class="font-mono text-lg font-bold tracking-widest uppercase">
							{latestTransmission.data.rows[0].title}
						</p>
						<p class="line-clamp-1 font-mono text-green-600">
							<span>
								{new Date(
									latestTransmission.data.rows[0].date_created as string,
								).toLocaleDateString("en-US", {
									year: "numeric",
									month: "short",
									day: "numeric",
								})}
							</span>
							- {latestTransmission.data.rows[0].subtitle}
						</p>
					</Container>
				) : (
					<Container>
						<ErrorOut error={latestTransmission.error as Error} />
					</Container>
				)
			}
		</section>
		<hr class="border-green-500" />
		<section class="space-y-5">
			<h3 class="text-xl font-bold tracking-widest">&gt; MAIN_MENU</h3>
			<div class="grid grid-cols-1 gap-6 font-mono font-bold lg:grid-cols-3">
				<Button
					class="group py-3! text-left"
					onclick="location.href='projects'"
				>
					<span class="mr-2 group-hover:animate-ping">&gt; </span> [ DIR ] PROJECTS
				</Button>
				<Button
					class="group py-3! text-left"
					onclick="location.href='transmission'"
				>
					<span class="mr-2 group-hover:animate-ping">&gt; </span> [ LOG ] TRANSMISSION_LOG
				</Button>
				<Button class="group py-3! text-left" onclick="location.href='gallery'">
					<span class="mr-2 group-hover:animate-ping">&gt; </span> [ PCX ] GALLERY
				</Button>
			</div>
		</section>
		<section class="columns-1 gap-6 space-y-6 lg:columns-2">
			<Container class="break-inside-avoid space-y-5 bg-black!">
				<p class="text-lg font-bold tracking-widest">&gt; STACK</p>
				<hr class="border border-green-500/30" />
				<div
					class="grid grid-cols-3 place-items-center gap-4 brightness-90 md:grid-cols-5"
				>
					{
						stack.map((language) => (
							<div class="group flex cursor-pointer flex-col items-center gap-2">
								<img
									class="h-10 w-10 object-contain transition-all duration-300 ease-out group-hover:scale-110 group-hover:drop-shadow-[0_0_20px_rgba(34,197,94,0.8)] lg:w-12"
									src={language.icon}
									loading="lazy"
									alt={`${language.name} icon`}
								/>
								<p class="font-mono text-xs font-bold transition-colors duration-300 group-hover:text-green-400">
									{language.name}
								</p>
							</div>
						))
					}
				</div>
			</Container>
			<Container class="break-inside-avoid space-y-5 bg-black!">
				<p class="text-lg font-bold tracking-widest">&gt; COMMIT_LOG</p>
				<hr class="border border-green-500/30" />
				<CommitLog />
				<Heatmap />
			</Container>
			<Container class="break-inside-avoid space-y-5 bg-black!">
				<LastFM client:idle />
			</Container>
			<Container class="break-inside-avoid space-y-5">
				<Ascii
					ascii={siteSettings.get("index.art") as string}
					class="glitch opacity-90"
				/>
				<hr class="border border-green-500/30" />
				<p class="text-center font-mono text-sm italic">
					{siteSettings.get("index.quote")}
				</p>
			</Container>
		</section>
	</main>
</Layout>
