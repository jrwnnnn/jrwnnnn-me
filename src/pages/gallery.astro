---
import { env } from "cloudflare:workers";
import Header from "@/layouts/Header.astro";
import Layout from "@/layouts/Layout.astro";

interface Images {
	success: boolean;
	results: { id: number; fileName: string; link: string }[];
}

let images: Images = { success: false, results: [] };
let error: Error | null = null;

try {
	images = await env.DB.prepare("SELECT * FROM galler ORDER BY id DESC").all();

	if (!images.success)
		throw new Error("Failed to fetch images from the database");
} catch (e) {
	error = e as Error;
}

const cfJwt = Astro.cookies.get("CF_Authorization")?.value;
---

<Layout title="Mark Jerwin // GALLERY">
	<main class="flex flex-col space-y-8">
		<Header heading="GALLERY">
			<p class="text-primary/80 font-mono text-sm">
				Found {images.results.length} images in the database. Captured using a Samsung
				A15 5G, Samsung A02s, or Samsung PL20.
			</p>
		</Header>

		<hr class="bg-primary" />

		{
			(import.meta.env.DEV || cfJwt) && (
				<>
					<div
						id="dropzone"
						class="hover:bg-primary/10 flex min-h-[16rem] cursor-pointer flex-col items-center justify-center border border-dashed"
					>
						<p class="mb-3 font-mono text-4xl">+</p>
						<p class="font-mono text-xs tracking-widest uppercase">
							Upload image
						</p>
					</div>

					<form id="uploadForm" class="hidden">
						<input type="file" name="filePicker" accept="image/*" required />
						<button type="submit"> Upload </button>
					</form>
				</>
			)
		}
		{
			!error ? (
				<div class="columns-1 gap-6 space-y-6 lg:columns-3">
					{images.results.map((image) => (
						<div class="relative break-inside-avoid">
							<img
								src={image.link as string}
								alt={`${image.fileName}`}
								class="gallery-image hover:outline-primary w-full cursor-pointer hover:outline"
								loading="eager"
							/>
							{(import.meta.env.DEV || cfJwt) && (
								<button
									class="delete-btn absolute top-2 right-2 cursor-pointer border border-red-500 bg-black/80 px-2 py-1 font-mono text-xs tracking-widest text-red-500"
									data-id={image.id}
									data-filename={image.fileName}
								>
									✕ DELETE
								</button>
							)}
						</div>
					))}
				</div>
			) : (
				<p class="font-mono text-sm text-red-500">{error.stack}</p>
			)
		}
	</main>
</Layout>

<script>
	import { stripGPS } from "@/utils/stripGPS";

	const dropzone = document.getElementById("dropzone") as HTMLDivElement;
	const form = document.getElementById("uploadForm") as HTMLFormElement;

	// Trigger the file picker
	dropzone.addEventListener("click", () => {
		form.filePicker.click();
	});

	// When a file is selected, automatically submit the form
	form.filePicker.addEventListener("change", () => {
		form.requestSubmit();
	});

	form.addEventListener("submit", async (e) => {
		e.preventDefault();

		const formData = new FormData();
		formData.append("file", await stripGPS(form.filePicker.files[0]));

		const res = await fetch("/secure/api/upload-to-gallery", {
			method: "POST",
			body: formData,
		});

		if (res.ok) {
			location.reload();
		} else {
			alert("Failed to upload image.");
		}
	});

	document
		.querySelectorAll<HTMLButtonElement>(".delete-btn")
		.forEach((deleteButton) => {
			deleteButton.addEventListener("click", async () => {
				const id = deleteButton.dataset.id;
				const fileName = deleteButton.dataset.filename;

				if (!confirm(`Are you sure you want to delete this image?`)) return;

				document.querySelector("body")?.classList.add("overflow-hidden");

				const formData = new FormData();
				if (id && fileName) {
					formData.append("id", id);
					formData.append("fileName", fileName);
				}

				const res = await fetch("/secure/api/delete-from-gallery", {
					method: "POST",
					body: formData,
				});

				if (res.ok) {
					location.reload();
				} else {
					// TODO: This as well
					document.querySelector("body")?.classList.remove("overflow-hidden");
					alert("Failed to delete image.");
				}
			});
		});
</script>
