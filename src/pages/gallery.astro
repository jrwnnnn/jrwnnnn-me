---
import { safeAsync } from "@utils/safeAsync";
import { createClient } from "@libsql/client";

import Header from "../layouts/Header.astro";
import Layout from "../layouts/Layout.astro";

import ErrorOut from "../components/ErrorOut.astro";

interface Row {
	id: number;
	image_data: string;
}

const turso = createClient({
	url: process.env.TURSO_DATABASE_URL || import.meta.env.TURSO_DATABASE_URL,
	authToken: process.env.TURSO_AUTH_TOKEN || import.meta.env.TURSO_AUTH_TOKEN,
});

const { data: result, error: error } = await safeAsync(
	turso.execute("SELECT id, image_data FROM gallery ORDER BY id DESC"),
);
const images = (result?.rows ?? []) as unknown as Row[];
---

<Layout title="Mark Jerwin // GALLERY">
	<main class="flex flex-col space-y-8">
		<Header heading="GALLERY">
			<p class="font-mono text-sm opacity-80">
				Found {images.length} images in the database. Captured using a Samsung A15
				5G, Samsung A02s, or Samsung PL20.
			</p>
		</Header>
		<hr class="bg-green-500" />
		<div class="columns-1 gap-6 space-y-6 lg:columns-3">
			{
				error ? (
					<ErrorOut error={error as Error} />
				) : (
					images.map((row: Row) => (
						<div class="break-inside-avoid">
							<img
								src={row.image_data}
								alt={`Image ${row.id}`}
								class="gallery-image phosphor-filter w-full cursor-pointer border border-green-500/0 hover:border-green-500 hover:filter-none!"
								loading="lazy"
								oncontextmenu="return false"
							/>
						</div>
					))
				)
			}
		</div>
	</main>
</Layout>
