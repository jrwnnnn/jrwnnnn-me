---
import "../../styles/marked.css";
import { createHash } from "node:crypto";
import { env } from "cloudflare:workers";
import { marked } from "marked";
import Layout from "../../layouts/Layout.astro";

const article = await env.DB.prepare(
	"UPDATE articles SET views = views + 1 WHERE slug = ? RETURNING *",
)
	.bind(Astro.params.slug)
	.all();

if (article.results[0].length === 0) {
	return Astro.rewrite("/404");
}
---

<Layout
	title={article.results[0].title as string}
	description={article.results[0].subtitle as string}
>
	<main class="flex flex-col items-center justify-center">
		<div class="w-full font-mono lg:w-[60vw]">
			<statusbar
				class="flex items-center justify-between border border-b-0 border-green-800 bg-green-900/20 px-4 py-2 text-xs tracking-widest uppercase"
			>
				<span>
					ID:{" "}
					{
						createHash("md5")
							.update(article.results[0].slug as string)
							.digest("hex")
							.substring(0, 10)
					}
				</span>
				<time datetime={new Date().toISOString()}>
					{
						new Date(
							article.results[0].date_created as string,
						).toLocaleDateString("en-US", {
							year: "numeric",
							month: "short",
							day: "numeric",
						})
					}
				</time>
			</statusbar>

			<div
				class="flex flex-col space-y-5 border border-green-800 bg-black p-6 md:p-12"
			>
				<p
					class="w-full rounded-none text-4xl leading-none font-bold uppercase outline-none md:text-5xl"
				>
					{article.results[0].title as string}
				</p>
				<p class="w-full text-lg text-green-600 outline-none">
					{article.results[0].subtitle as string}
				</p>

				<hr class="border border-green-900/50" />

				<div
					class="prose"
					set:html={marked.parse(article.results[0].content as string)}
				/>

				<hr class="border border-green-900/50" />

				<div>
					<p class="text-center text-sm text-green-800 italic">
						END OF TRANSMISSION
					</p>
					<p class="text-center text-sm text-green-800 italic">
						Transmission ID:
						<span class="tracking-wide uppercase">
							{
								createHash("md5")
									.update(article.results[0].slug as string)
									.digest("hex")
									.substring(0, 20)
							}
						</span>
					</p>
				</div>
			</div>
		</div>
	</main>
</Layout>
