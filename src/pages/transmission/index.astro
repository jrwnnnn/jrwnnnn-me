---
import { createClient } from "@tursodatabase/serverless/compat";
import { safeAsync } from "@utils/safeAsync";
import Ascii from "../../components/AsciiContainer.astro";
import ErrorOut from "../../components/ErrorOut.astro";
import Header from "../../layouts/Header.astro";
import Layout from "../../layouts/Layout.astro";
import Timestamp from "../../components/Timestamp.astro";

import sql from "../../data/sql.txt?raw";

interface Transmission {
	type: "rating" | "article";
	title: string;
	subtitle?: string;
	notes?: string;
	rating: number;
	cover?: string;
	url: string;
	date_created: string;
}

const turso = createClient({
	url: import.meta.env.TURSO_DATABASE_URL,
	authToken: import.meta.env.TURSO_AUTH_TOKEN,
});
const result = await safeAsync(turso.execute(sql));
const transmissions = result.data?.rows as unknown as Transmission[];
---

<Layout title="Mark Jerwin // TRANSMISSION_LOG">
	<main class="mx-auto flex max-w-5xl flex-col space-y-8">
		<Header heading="TRANSMISSION_LOG">
			<p class="font-mono text-sm opacity-80">
				Parsing {transmissions.length} transmission records... [{
					result.error ? "ERROR" : "OK"
				}]
			</p>
		</Header>

		<hr class="bg-green-500" />

		<div class="flex flex-col space-y-5">
			{
				result.data ? (
					transmissions.map((transmission) => {
						if (transmission.type === "article") {
							return (
								<div class="space-y-3">
									<Timestamp timestamp={transmission.date_created} />
									<a href={transmission.url}>
										<div class="space-y-5 border border-green-900/50 bg-black p-6 font-mono hover:border-green-500 hover:bg-green-900/10">
											<div class="">
												<p class="text-2xl font-bold uppercase md:text-3xl">
													{transmission.title}
												</p>
												{transmission.subtitle && (
													<p class="text-sm text-green-600 opacity-90">
														{">"} {transmission.subtitle}
													</p>
												)}
											</div>
										</div>
									</a>
								</div>
							);
						}

						if (transmission.type === "rating") {
							return (
								<div class="space-y-3">
									<Timestamp timestamp={transmission.date_created} />
									<a
										href={transmission.url}
										target="_blank"
										rel="noopener noreferrer"
									>
										<div class="group flex flex-col border border-green-900/50 bg-black font-mono hover:border-green-500 hover:bg-green-900/10 md:flex-row">
											{transmission.cover && (
												<div class="aspect-square shrink-0 overflow-clip md:h-40 md:w-40">
													<Ascii ascii={transmission.cover} />
												</div>
											)}
											<div class="flex w-full flex-col justify-between gap-3 p-5">
												<div class="space-y-3">
													<div class="flex items-start justify-between gap-4">
														<p class="line-clamp-2 text-xl leading-tight font-bold uppercase">
															{transmission.title}
														</p>
														<span class="mb-1 shrink bg-green-500 px-2 py-0.25 text-sm font-bold text-black">
															{transmission.rating}/10
														</span>
													</div>
													{transmission.notes && (
														<p class="line-clamp-3 border-l-2 border-green-500 pl-5 text-sm text-balance italic opacity-80">
															{transmission.notes}
														</p>
													)}
												</div>

												<div class="flex items-end justify-end opacity-50 transition-opacity group-hover:opacity-100">
													<svg
														version="1.0"
														xmlns="http://www.w3.org/2000/svg"
														width="512pt"
														height="512pt"
														viewBox="0 0 512 512"
														preserveAspectRatio="xMidYMid meet"
														fill="currentColor"
														class="h-4 w-4"
													>
														<g
															transform="translate(0.000000,512.000000) scale(0.100000,-0.100000)"
															stroke="none"
														>
															<path d="M1244 4465 c-261 -57 -483 -258 -572 -520 l-27 -80 0 -1305 0 -1305 27 -80 c93 -271 329 -479 599 -525 45 -8 439 -10 1329 -8 l1265 3 80 28 c244 86 416 258 502 502 l28 80 3 555 c3 623 4 619 -63 685 -98 99 -261 78 -332 -43 l-28 -47 -6 -535 c-3 -338 -9 -546 -16 -565 -45 -130 -125 -199 -258 -225 -44 -8 -387 -10 -1250 -8 -1144 3 -1192 4 -1243 22 -102 37 -176 127 -201 244 -16 75 -16 2369 0 2444 25 118 99 207 201 244 49 17 97 19 588 24 l535 5 47 28 c84 49 124 150 98 245 -15 56 -80 123 -136 140 -61 18 -1085 16 -1170 -3z" />
															<path d="M3120 4464 c-46 -20 -87 -60 -112 -108 -16 -31 -19 -53 -16 -102 5 -78 41 -136 108 -174 45 -25 46 -25 344 -28 l300 -3 -787 -787 c-551 -551 -791 -798 -802 -824 -38 -93 -6 -206 73 -262 49 -35 136 -46 198 -26 32 10 190 163 831 803 l792 791 3 -300 c3 -284 4 -301 25 -339 41 -77 105 -115 193 -115 84 0 161 53 194 132 14 32 16 115 16 606 0 399 -3 579 -11 603 -19 56 -59 100 -113 125 l-51 24 -575 0 c-491 -1 -580 -3 -610 -16z" />
														</g>
													</svg>
												</div>
											</div>
										</div>
									</a>
								</div>
							);
						}
						return null;
					})
				) : (
					<ErrorOut error={result.error as Error} />
				)
			}
		</div>
	</main>
</Layout>
