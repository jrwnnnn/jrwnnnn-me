---
import { env } from "cloudflare:workers";
import Ascii from "../../components/AsciiContainer.astro";
import Container from "../../components/Container.astro";
import Header from "../../layouts/Header.astro";
import Layout from "../../layouts/Layout.astro";

const transmissions = await env.DB.prepare(
	"SELECT slug, title, subtitle, art, date_created, tags FROM articles ORDER BY date_created DESC",
).all();

const cfJwt = Astro.cookies.get("CF_Authorization")?.value;
---

<Layout title="Mark Jerwin // TRANSMISSION_LOG">
	<main class="mx-auto flex w-full max-w-5xl flex-col space-y-8">
		<Header heading="TRANSMISSION_LOG">
			<div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
				<p class="text-primary/80 font-mono text-sm">
					Parsing {transmissions.results.length} transmission records... [{
						transmissions.success ? "OK" : "ERROR"
					}]
				</p>
				{
					(import.meta.env.DEV || cfJwt) && (
						<button
							onclick="window.location.href = '/secure/transmit';"
							class="border-primary hover:bg-primary/10 cursor-pointer border border-dashed px-3 py-2 font-mono text-xs tracking-widest transition-colors md:py-1"
						>
							+ NEW
						</button>
					)
				}
			</div>
		</Header>
		<hr class="bg-primary" />
		<div class="flex flex-col space-y-5">
			{
				transmissions.results.map((transmission) => (
					<>
						<time class="text-primary/70 mb-3 font-mono text-sm tracking-wide italic">
							[{" "}
							{new Date(transmission.date_created as string).toLocaleDateString(
								"en-US",
								{
									year: "numeric",

									month: "short",
									day: "numeric",
								},
							)}{" "}
							]
						</time>
						<Container
							class="shadow-primary/50 flex flex-col border border-green-900/50 bg-black font-mono hover:bg-green-900/10 hover:shadow-lg md:flex-row md:gap-5"
							onclick={`window.location.href = '/transmission/${transmission.slug}'`}
						>
							{transmission.art && (
								<>
									<Ascii
										ascii={transmission.art as string}
										class="aspect-square md:w-40"
										centered
									/>
									<hr class="border-primary/50 my-5 md:hidden" />
								</>
							)}

							<div class="flex flex-col justify-between">
								<div>
									<p class="text-2xl font-bold text-balance uppercase md:text-2xl">
										{transmission.title}
									</p>
									{transmission.subtitle && (
										<p class="text-primary/80 line-clamp-3 text-sm">
											{">"} {transmission.subtitle}
										</p>
									)}
								</div>
								{transmission.tags && (
									<div class="mt-3 flex flex-wrap gap-2">
										{(transmission.tags as string).split(",").map((tag) => (
											<span class="border-primary/80 bg-primary/10 text-primary/80 border px-3 py-1 text-[0.7rem] tracking-widest uppercase">
												{tag}
											</span>
										))}
									</div>
								)}
							</div>
						</Container>
					</>
				))
			}
		</div>
	</main>
</Layout>
