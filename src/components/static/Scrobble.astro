---

---

<div id="lastfm-widget" class="animate-pulse space-y-5">
	<p class="text-lg font-bold tracking-widest">> CONNECTING_TO_LAST_FM</p>
</div>

<script>
	interface Interface {
		name: string;
		artist: { "#text": string };
		album: { "#text": string };
		image: { "#text": string }[];
		url: string;
		"@attr"?: { nowplaying: string };
	}

	const widget = document.getElementById("lastfm-widget");

	const render = (tracks: Interface[]) => {
		const nowPlaying = tracks[0]["@attr"]?.nowplaying === "true";
		const recent = nowPlaying ? tracks.slice(1) : tracks;

		return `
            <div class="flex items-center justify-between">
                <p class="text-lg font-bold tracking-widest">> LAST_FM</p>
                <div class="${nowPlaying ? "bg-green-500" : "hidden"} px-3 py-px font-mono text-[12px] text-black animate-pulse">
                    LIVE
                </div>
            </div>
            <hr class="border border-green-500/30" />
            
            <a class="flex cursor-pointer flex-col gap-5 md:flex-row" ${nowPlaying ? `href=${tracks[0].url}` : ""} target="_blank">
				<div class="group relative w-full border border-green-500 md:w-30">
					<img
						src="${nowPlaying ? tracks[0].image[3]["#text"] : "https://www.last.fm/static/images/lastfm_avatar_twitter.52a5d69a85ac.png"}" 
						alt="${nowPlaying ? tracks[0].album["#text"] : "LastFM"}" 
						class="h-full w-full object-cover contrast-125 grayscale transition group-hover:contrast-100 group-hover:grayscale-0"
					/>
					<div
						class="pointer-events-none absolute inset-0 bg-green-500/90 mix-blend-multiply group-hover:hidden"
					>
					</div>
				</div>
                <div>
                    <p class="text-lg font-bold tracking-wide">${nowPlaying ? tracks[0].name : "Nothing is currently being played..."}</p>
                    <p class="font-mono text-sm text-green-600">${nowPlaying ? `Artist: ${tracks[0].artist["#text"]}` : "Offline"}</p>
                    <p class="font-mono text-sm text-green-600 ${!nowPlaying ? "hidden" : ""}">Album: ${tracks[0].album["#text"]}</p>
                </div>
            </a>

            <div class="flex items-center gap-2">
                <hr class="grow border border-dashed border-green-900" />
                <p class="text-center font-mono text-xs tracking-widest text-green-900">Recent Tracks</p>
                <hr class="grow border border-dashed border-green-900" />
            </div>
            
            <div class="flex flex-col gap-1">
                ${recent
									.map(
										(track) => `
                    <a href="${track.url}" target="_blank" class="flex gap-5 font-mono text-sm md:flex md:justify-between hover:text-green-400 transition-colors">
                        <p class="line-clamp-1 text-green-600">${track.name}</p>
                        <p class="line-clamp-1 text-left text-green-800 whitespace-nowrap">${track.artist["#text"]}</p>
                    </a>
                `,
									)
									.join("")}
            </div>
        `;
	};

	const fetchAndRender = async () => {
		try {
			const data = await (await fetch("/api/lastfm-endpoint")).json();
			const tracks = data.recenttracks.track as Interface[];

			widget!.innerHTML = render(tracks);
			widget!.classList.remove("animate-pulse");
		} catch (e) {
			console.error(e);
		}
	};

	fetchAndRender();
	setInterval(fetchAndRender, 10000);
</script>
