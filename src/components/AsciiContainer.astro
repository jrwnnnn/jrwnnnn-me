---
interface Props {
	class?: string;
	ascii: string;
	centered?: boolean;
}
const {
	class: additionalClasses = "",
	ascii = "",
	centered = false,
} = Astro.props;

const cols =
	ascii
		.split(/\r\n|\r|\n/)
		.reduce((max, line) => Math.max(max, line.length), 0) || 1;
---

<div
	class=`@container overflow-hidden ${centered ? "flex items-center justify-center" : ""} ${additionalClasses}`
	style=`--cols: ${cols}`
>
	<pre
		class="font-['ibm'] text-[calc(186cqi/var(--cols))] leading-none"
		style="letter-spacing: 0.12em">{ascii}</pre>
</div>
