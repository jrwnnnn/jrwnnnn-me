---
const lastfm = await (
  await fetch(
    `https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=KeiCantRead&api_key=${import.meta.env.LASTFM_API_KEY}&format=json&limit=5`,
  )
).json();
---

<!-- TODO: Implement realtime ajax-->
<div
  class=`bg-green-500 py-px px-2 font-mono text-[12px] font-bold text-black ${lastfm.recenttracks.track[0]['@attr']?.nowplaying === 'true' ? '' : 'hidden'}`
>
  NOW SCROBBLING
</div>
<a class="flex cursor-pointer gap-5" href={lastfm.recenttracks.track[0].url}>
  <div class="group relative w-30 border border-green-500">
    <img
      src={lastfm.recenttracks.track[0].image[3]["#text"]}
      alt={lastfm.recenttracks.track[0].album["#text"]}
      class="h-full w-full object-cover brightness-90 contrast-125 grayscale transition group-hover:brightness-100 group-hover:contrast-100 group-hover:grayscale-0"
    />

    <div
      class="pointer-events-none absolute inset-0 bg-green-500/90 mix-blend-multiply group-hover:hidden"
    >
    </div>
  </div>
  <div>
    <p class="mb-2 text-xl font-bold tracking-normal">
      {lastfm.recenttracks.track[0].name}
    </p>
    <p class="font-mono text-xs text-green-700">
      Artist: {lastfm.recenttracks.track[0].artist["#text"]}
    </p>
    <p class="font-mono text-xs text-green-700">
      Album: {lastfm.recenttracks.track[0].album["#text"]}
    </p>
  </div>
</a>
<div>
  <div class="flex items-center gap-2">
    <hr class="grow border border-dashed border-green-900" />
    <p class="text-center font-mono text-xs tracking-widest text-green-900">
      Recent Tracks
    </p>
    <hr class="grow border border-dashed border-green-900" />
  </div>
  {
    lastfm.recenttracks.track.slice(1).map((track: any) => (
      <div class="flex items-center justify-between">
        <p class="text-green-600">{track.name}</p>
        <p class="font-mono text-xs text-green-700">{track.artist["#text"]}</p>
      </div>
    ))
  }
</div>
