---
import { Image } from "astro:assets";

let lastfm;
let error = false;

try {
  const response = await fetch(
    `https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=KeiCantRead&api_key=${import.meta.env.LASTFM_API_KEY}&format=json&limit=5`,
    {
      headers: {
        "User-Agent": "Mozilla/5.0",
      },
    },
  );

  if (!response.ok) {
    throw new Error(`HTTP error! status: ${response.status}`);
  }

  lastfm = await response.json();
} catch (e) {
  console.error("Last.fm fetch error:", e);
  error = true;
}
---

{
  error ? (
    <div class="border border-red-500/30 bg-red-950/20 p-4">
      <p class="font-mono text-sm text-red-500">
        ⚠ Failed to load Last.fm data. Check API key or try again later.
      </p>
    </div>
  ) : lastfm?.recenttracks?.track ? (
    <>
      <div
        class={`bg-green-500 px-2 py-px font-mono text-[12px] font-bold text-black ${lastfm.recenttracks.track[0]["@attr"]?.nowplaying === "true" ? "" : "hidden"}`}
      >
        NOW SCROBBLING
      </div>
      <a
        class="flex cursor-pointer gap-5"
        href={lastfm.recenttracks.track[0].url}
      >
        <div class="group relative w-30 border border-green-500">
          <Image
            src={lastfm.recenttracks.track[0].image[3]["#text"]}
            alt={lastfm.recenttracks.track[0].album["#text"]}
            width="300"
            height="300"
            class="h-full w-full object-cover brightness-90 contrast-125 grayscale transition group-hover:brightness-100 group-hover:contrast-100 group-hover:grayscale-0"
          />

          <div class="pointer-events-none absolute inset-0 bg-green-500/90 mix-blend-multiply group-hover:hidden"></div>
        </div>
        <div>
          <p class="mb-2 text-xl font-bold tracking-normal">
            {lastfm.recenttracks.track[0].name}
          </p>
          <p class="font-mono text-xs text-green-700 line-clamp-1">
            Artist: {lastfm.recenttracks.track[0].artist["#text"]}
          </p>
          <p class="font-mono text-xs text-green-700 line-clamp-1">
            Album: {lastfm.recenttracks.track[0].album["#text"]}
          </p>
        </div>
      </a>
      <div>
        <div class="flex items-center gap-2">
          <hr class="grow border border-dashed border-green-900" />
          <p class="text-center font-mono text-xs tracking-widest text-green-900">
            Recent Tracks
          </p>
          <hr class="grow border border-dashed border-green-900" />
        </div>
        {lastfm.recenttracks.track.slice(1).map((track: any) => (
          <div class="flex items-center justify-between">
            <p class="text-green-600 line-clamp-1">{track.name}</p>
            <p class="font-mono text-xs text-green-700 line-clamp-1">
              {track.artist["#text"]}
            </p>
          </div>
        ))}
      </div>
    </>
  ) : (
    <div class="border border-yellow-500/30 bg-yellow-950/20 p-4">
      <p class="font-mono text-sm text-yellow-500">
        ⚠ No Last.fm data available
      </p>
    </div>
  )
}
