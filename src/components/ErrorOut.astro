---
interface Props {
	error?: Error;
}
const { error = null } = Astro.props;
const errorMessage = error?.message || "Unknown error";
const errorTrace = error?.stack || "";
---

<script is:inline define:vars={{ errorTrace }}>
	console.error(errorTrace);
</script>

<div class="space-y-2 font-mono">
	<details>
		<summary class="cursor-pointer font-bold text-red-500"
			>{errorMessage}</summary
		>
		<p
			class="text-primary/60 hover:[&::-webkit-scrollbar-thumb]:bg-primary mt-1 max-h-40 overflow-y-auto text-sm [&::-webkit-scrollbar]:w-1 [&::-webkit-scrollbar-thumb]:bg-transparent"
		>
			<strong>Stack Trace</strong> // {errorTrace}
		</p>
	</details>
</div>
