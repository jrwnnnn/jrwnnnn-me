---
interface Props {
	id?: string;
	class?: string;
	hover?: boolean;
	onclick?: string;
}

let { id, class: additionalClasses, hover = false, onclick = "" } = Astro.props;
if (onclick !== "") {
	hover = true;
}
---

<div
	id={id}
	class={`border border-primary md:p-6 p-5 ${hover ? "transition hover:bg-primary/10 focus:bg-primary-dark/10 cursor-pointer" : ""} ${additionalClasses}`}
	onclick={onclick}
>
	<slot />
</div>
