---
interface Props {
	timestamp: string;
}

const { timestamp } = Astro.props as Props;
---

<time class="font-mono text-sm tracking-wide text-green-700 italic">
	[{" "}
	{
		new Date(timestamp).toLocaleDateString("en-US", {
			year: "numeric",
			month: "short",
			day: "numeric",
		})
	}{" "}
	]
</time>
