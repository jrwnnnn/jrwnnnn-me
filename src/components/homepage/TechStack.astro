---
const techStack = [
	{ icon: "icons/stack/javascript.svg", name: "JavaScript" },
	{ icon: "icons/stack/astro.svg", name: "Astro" },
	{ icon: "icons/stack/php.svg", name: "PHP" },
	{ icon: "icons/stack/react.svg", name: "React" },
	{ icon: "icons/stack/tailwindcss.svg", name: "Tailwind CSS" },
	{ icon: "icons/stack/mariadb.svg", name: "MariaDB" },
];
---
<div
	class="grid grid-cols-3 place-items-center gap-4 brightness-90 md:grid-cols-5"
>
	{
		techStack.map((entry) => (
			<div class="flex flex-col items-center gap-2">
				<span
					class="bg-primary h-10 w-10 lg:w-12"
					style={`mask: url('${entry.icon}') no-repeat center / contain; -webkit-mask: url('${entry.icon}') no-repeat center / contain;`}
				/>
				<p class="truncate text-center font-mono text-sm">{entry.name}</p>
			</div>
		))
	}
</div>
