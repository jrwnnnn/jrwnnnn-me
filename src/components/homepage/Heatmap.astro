---
interface ContributionDay {
	contributionCount: number;
	date: string;
}

interface Week {
	contributionDays: ContributionDay[];
}

interface GraphQL {
	data: {
		user: {
			contributionsCollection: {
				contributionCalendar: {
					totalContributions: number;
					weeks: Week[];
				};
			};
		};
	};
}

const response = await fetch("https://api.github.com/graphql", {
	method: "POST",
	headers: {
		Authorization: `Bearer ${import.meta.env.GITHUB_TOKEN}`,
		"User-Agent": "jrwnnnn-me-heatmap",
		"Content-Type": "application/json",
	},
	body: JSON.stringify({
		query: `
		  query($userName:String!) {
			user(login: $userName) {
			  contributionsCollection {
				contributionCalendar {
				  totalContributions
				  weeks {
					contributionDays {
					  contributionCount
					  date
					}
				  }
				}
			  }
			}
		  }
		`,
		variables: { userName: "jrwnnnn" },
	}),
});

if (!response.ok) return;

const graphql = (await response.json()) as GraphQL;
const contributions =
	graphql.data.user.contributionsCollection.contributionCalendar.weeks.flatMap(
		(w: Week) => w.contributionDays,
	);

function getColor(count: number) {
	const ratio =
		count /
		Math.max(...contributions.map((d: ContributionDay) => d.contributionCount));

	if (count === 0) return "bg-black";
	if (ratio <= 0.25) return "bg-primary/25";
	if (ratio <= 0.5) return "bg-primary/50";
	if (ratio <= 0.75) return "bg-primary";
	return "bg-primary";
}
---

{
	(
		<div id="heatmap" class="w-full cursor-pointer overflow-x-auto pb-2">
			<div class="flex gap-1">
				{graphql.data.user.contributionsCollection?.contributionCalendar.weeks.map(
					(week: Week) => (
						<div class="flex flex-col gap-1">
							{week.contributionDays.map((day: ContributionDay) => (
								<div
									class={`ring-primary/10 h-3 w-3 ring-1 transition-opacity ring-inset hover:opacity-80 ${getColor(day.contributionCount)}`}
									title={`${day.contributionCount} contributions on ${day.date}`}
								/>
							))}
						</div>
					),
				)}
			</div>
		</div>

		// TODO: Add error a proper error handling in case the API request fails
	)
}

<script>
	const container = document.getElementById("heatmap");
	if (container) {
		container.scrollLeft = container.scrollWidth;
	}
</script>

