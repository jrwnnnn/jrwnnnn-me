---
import ErrorOut from "../ErrorOut.astro";
import { safeAsync } from "@utils/safeAsync";

interface Commit {
	sha: string;
	url: string;
	commit: {
		author: {
			date: string;
		};
		message: string;
	};
	html_url: string;
	stats: {
		additions: number;
		deletions: number;
	};
}

const result = await safeAsync(
	fetch(
		"https://raw.githubusercontent.com/jrwnnnn/jrwnnnn-me/refs/heads/data/commits.json",
	).then((res) => res.json() as Promise<Commit[]>),
);
---

{
	result.data ? (
		<div class="space-y-4 font-mono text-sm">
			{result.data.map((commit: Commit) => (
				<a
					href={commit.html_url}
					target="_blank"
					class="group block space-y-1 border-l-3 border-green-500/40 pl-5 transition hover:border-green-500"
				>
					<div class="flex items-start justify-between gap-5">
						<p class="mb-1 line-clamp-2">
							<strong>{commit.url.split("/")[5]}</strong> /{" "}
							{commit.commit.message}
						</p>
					</div>
					<div class="flex items-start gap-2 text-green-800 group-hover:brightness-120">
						<p class="text-xs">
							{new Date(commit.commit.author.date).toLocaleDateString("en-GB", {
								day: "2-digit",
								month: "2-digit",
								year: "numeric",
							})}
						</p>
						<p> | </p>
						<div class="flex space-x-3 text-xs">
							<span>+{commit.stats.additions}</span>
							<span>-{commit.stats.deletions}</span>
						</div>
						<p> | </p>
						<p class="text-xs">{commit.sha.substring(0, 7)}</p>
					</div>
				</a>
			))}
		</div>
	) : (
		<ErrorOut error={result.error as Error} />
	)
}
